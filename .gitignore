.next/
*.tsbuildinfo

# Test output
/playwright-report/
/test-results/

# Secrets. .env.local holds the service-role key, which bypasses row-level
# security entirely — committing it would hand write access to the whole
# database to anyone who can read the repo.
#
# This file previously listed only build output, while the README claimed
# .env.local was ignored. It was not. Anything matching these patterns
# stays out of git.
.env
.env.local
.env.*.local
.env.production

# The Rigveda harvest: the accented samhita (3.4 MB) and 1,028 pages of
# Sayana's bhashya (34 MB). Both are re-fetched by
# scripts/rigveda/fetch-samhita.mjs and fetch-spine.mjs, and the corpus
# the site actually reads is committed under src/lib/rigveda/data. The
# parsed spine (rv-spine-raw.json) IS committed, so what the editorial
# layer in src/lib/rigveda/devatas.ts does to the raw field can be
# checked without re-harvesting anything.
/corpus/rigveda/rv-sasvara-raw.txt
/corpus/rigveda/suktas/
