# Phase 0 requires a live Supabase project — see docs/ROADMAP.md and README.md.
#
# 1. Create a project at https://supabase.com
# 2. Run supabase/schema.sql in its SQL Editor
# 3. Settings → API → copy these values:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 4. Authentication → Users → Add user (email + password) for yourself, then
#    set this to that same email. /admin is gated on this one address —
#    there is no roles/permissions system, by design (see docs/ROADMAP.md).
ADMIN_EMAIL=

# ── Production ─────────────────────────────────────────────
# The site's own address, used for sign-in redirects (e.g. https://tattvamasi.example).
NEXT_PUBLIC_SITE_URL=
# Signs the reading-meter cookie. Set a long random string; if empty the
# service-role key is used. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
METER_SECRET=
# Proxies of our own in front of the app. Vercel: 1 (the default).
TRUSTED_PROXY_HOPS=1
# "on" only once Supabase has working SMTP; otherwise sign-in is Google only.
SIGNIN_EMAIL=
# Leave unset in production. READING_GATE=off disables the five-page meter;
# RATE_LIMIT=off is for local test runs only.
# READING_GATE=
# RATE_LIMIT=
