# Phase 0 requires a live Supabase project — see docs/ROADMAP.md and README.md.
#
# 1. Create a project at https://supabase.com
# 2. Run supabase/schema.sql in its SQL Editor
# 3. Settings → API → copy these values:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 4. Authentication → Users → Add user (email + password) for yourself, then
#    set this to that same email. /admin is gated on this one address —
#    there is no roles/permissions system, by design (see docs/ROADMAP.md).
ADMIN_EMAIL=
