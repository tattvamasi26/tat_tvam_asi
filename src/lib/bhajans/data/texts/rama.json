ಲನು ||"]],"transliteration":[["Bandanene sundara sri ramachandira bandanene ||"],["Sirivatsadharanu sritajanodhaaranu maarasundaranu maamanoharanu ||"],["Komalagaatranu kamala kalatranu kamalaapta tejanu vimala satpaatranu ||"],["Saasiranaamanu bhasura vadananu esha vanditanu shesha vittalanu ||"]],"aligned":true,"video":"wYQtf8lCkfA","videos":["wYQtf8lCkfA"],"sourceUrl":"https://bhakthilahari.com/2021/03/14/%e0%b2%ac%e0%b2%82%e0%b2%a6%e0%b2%a8%e0%b3%87%e0%b2%a8%e0%b3%87-%e0%b2%b8%e0%b3%81%e0%b2%82%e0%b2%a6%e0%b2%b0-%e0%b2%b6%e0%b3%8d%e0%b2%b0%e0%b3%80%e0%b2%b0%e0%b2%be%e0%b2%ae%e0%b2%9a%e0%b2%82%e0%b2%a6/"},{"slug":"ede-rama-naama","titleKn":"ಇದೇ ರಾಮ ನಾಮ","titleEn":"Ede rama naama","form":"song","composer":null,"ankita":null,"raga":null,"tala":null,"stanzas":[["ಇದೇ ರಾಮ ನಾಮ ಪರಮ ರಾಮ ನಾಮಾ","ಪರಾಮಾತ್ಮ ಧ್ಯಾನ ಶ್ರೀ ರಾಮ, ರಾಮ","ಪರಾಮಾತ್ಮ ಧ್ಯಾನ ಶ್ರೀರಾಮ||"],["ಶಿಲೆಯ ಮೆಟ್ಟಿ ವನಿತೆಯ ಗೈದ","ಶಿವ ಧನುಸನು ಮುರಿದ ರಾಮ","ಶಿವ ಭಕ್ತ ರಾವಣನನ್ನು ಸಂಹರಿಸಿ ಮೆರೆದ ರಾಮ|","ಹರಿಯೂ ಹರನು ಒಂದೇ ಎಂದೂ ಸಾರಿ ಸಾರಿ ಹೇಳಿದ ರಾಮ ||"],["ಚಂದ್ರ ಸೇನವ ನಂಬಿದ ರಾಮ","ಜಾಂಬವಂತನ ಜಪಿಸಿದ ರಾಮ","ಸುಗ್ರೀವ ಸಾರಿದ ರಾಮ","ತಾಯೇ ಶಬರಿ ಹಾಡಿದ ರಾಮ","ಜನನ ಮರಣ ಕಳೆಯುವ ರಾಮ","ವೀರ ಹನುಮ ತೋರಿದ ರಾಮ||"]],"transliteration":[["Ede rama naama parama rama naama paramatma dhyana sri rama, raama paramatma dhyana sri rama ||"],["Shileya metti vaniteya gaida | shiva dhanusanu murida rama || shiva bhakta ravananannu samharisi mereda rama | hariyu haranu onde endu sari sari helida rama ||"],["Chandra senava nambida rama jaambavanthana japisida Rama sugreeva saarida Rama | taaye shabari hadida Rama | janana marana kaleyuva rama veera hanuma torida rama ||"]],"aligned":true,"video":"OTSuteoPGaE","videos":["OTSuteoPGaE"],"sourceUrl":"https://bhakthilahari.com/2020/09/10/%e0%b2%87%e0%b2%a6%e0%b3%87-%e0%b2%b0%e0%b2%be%e0%b2%ae-%e0%b2%a8%e0%b2%be%e0%b2%ae-ede-rama-naama/"},{"slug":"eshtu-sahasavanta","titleKn":"ಎಷ್ಟು ಸಾಹಸವಂತ","titleEn":"Eshtu sahasavanta","form":"pada","composer":"vadiraja","ankita":"ಹಯವದನ","raga":null,"tala":null,"stanzas":[["ಶ್ರೀ ವಾದಿರಾಜರ ಕೃತಿ"],["ಹಾಡಿದವರು : ಶ್ರೀ ವಿದ್ಯಾಭೂಷಣ ತೀರ್ಥರು ರಾಗ : ಮಧ್ಯಮಾವತಿ","ಎಷ್ಟು ಸಾಹಸವಂತ ನೀನೇ ಬಲವಂತ","ದಿಟ್ಟ ಮೂರುತಿ ಭಳಿಭಳಿರೇ ಹನುಮಂತ ॥ ಪ ॥","ಅಟ್ಟುವ ಖಳರೆದೆ ಮೆಟ್ಟಿ ತುಳಿದು ತಲೆ","ಕುಟ್ಟಿ ಚೆಂಡಾಡಿದ ದಿಟ್ಟ ನೀನಹುದೋ ॥ ಅ ಪ ॥","ರಾಮರಪ್ಪಣೆಯಿಂದ ಶರಧಿಯ ದಾಟಿ","ಆ ಮಹಾ ಲಂಕೆಯ ಕಂಡೆ ಕಿರೀಟಿ","ಸ್ವಾಮಿಯ ಕಾರ್ಯವ ಪ್ರೇಮದಿ ನಡೆಸಿದಿ","ಈ ಮಹಿಯೊಳು ನಿನಗಾರೈ ಸಾಟಿ ॥ 1 ॥","ದೂರದಿಂದಸುರನ ಪುರವನ್ನು ನೋಡಿ","ಭರದಿ ಶ್ರೀರಾಮರ ಸ್ಮರಣೆಯ ಮಾಡಿ","ಹಾರಿದೆ ಹರುಷದಿ ಹರಿಸಿ ಲಂಕಿಣಿಯನು","ವಾರಿಜಮುಖಿಯನು ಕಂಡು ಮಾತಾಡಿ ॥ 2 ॥","ರಾಮರ ಕ್ಷೇಮವ ರಮಣಿಗೆ ಪೇಳಿ","ತಾಮಸ ಮಾಡದೆ ಮುದ್ರಿಕೆ ನೀಡಿ","ಪ್ರೇಮದಿ ಜಾನಕಿ ಕುರುಹನು ಕೊಡಲಾಗ","ಆ ಮಹಾವನದೊಳು ಫಲವನು ಬೇಡಿ ॥ 3 ॥","ಕಣ್ಣಿಗೆ ಪ್ರಿಯವಾದ ಹಣ್ಣನು ಕೊಯ್ದು","ಹಣ್ಣಿನ ನೆವದಲಿ ಅಸುರರ ಹೊಯ್ದು","ಪಣ್ಣಪಣ್ಣನೆ ಹಾರಿ ನೆಗೆನೆಗೆದಾಡುತ","ಬಣ್ಣಿಸಿ ಅಸುರರ ಬಲವನು ಮುರಿದು ॥ 4 ॥","ಶೃಂಗಾರ ವನದೊಳಗಿದ್ದ ರಾಕ್ಷಸರ","ಅಂಗವನಳಿಸಿದೆ ಅತಿರಣಶೂರ","ನುಂಗಿ ಅಸ್ತ್ರಗಳ ಅಕ್ಷಕುವರನ","ಭಂಗಿಸಿ ಬಿಸುಟೆಯೋ ಬಂದ ರಕ್ಕಸರ ॥ 5 ॥","ದೂರು ಪೇಳಿದರೆಲ್ಲಾ ರಾವಣನೊಡನೆ","ಚೀರುತ್ತ ಕರೆಸಿದ ಇಂದ್ರಜಿತುವನೆ","ಚೋರಕಪಿಯ ನೀ ಹಿಡಿತಹುದೆನ್ನುತ","ಶೂರರ ಕಳುಹಿದ ನಿಜಸುತನೊಡನೆ ॥ 6 ॥","ಪಿಡಿದನು ಇಂದ್ರಜಿತು ಕಡು ಕೋಪದಿಂದ","ಹೆಡೆಮುರಿ ಕಟ್ಟಿದ ಬ್ರಹ್ಮಾಸ್ತ್ರದಿಂದ","ಗುಡುಗುಡುಗುಟ್ಟುತ ಕಿಡಿಕಿಡಿಯಾಗುತ","ನಡೆದನು ಲಂಕೆಯ ಒಡೆಯನಿದ್ದೆಡೆಗೆ ॥ 7 ॥","ಕಂಡ ರಾವಣನು ಉದ್ದಂಡಕಪಿಯನು","ಮಂಡೆಯ ತೂಗುತ ಮಾತಾಡಿಸಿದನು","ಭಂಡು ಮಾಡದೆ ಬಿಡೆ ನೋಡು ಕಪಿಯನೆ","ಗಂಡುಗಲಿಯು ದುರುದುರಿಸಿ ನೋಡಿದನು ॥ 8 ॥","ಛಲವ್ಯಾಕೋ ನಿನಗಿಷ್ಟು ಎಲೆ ಕೊಡಗನೆ","ನೆಲೆಯಾವುದ್ಹೇಳೋ ನಿನ್ನೊಡೆಯನ್ಹೆಸರನ್ನು","ಬಲವಂತ ರಾಮರ ಬಂಟ ಬಂದಿಹೆನೋ","ಹಲವು ಮಾತ್ಯಾಕೋ ಹನುಮನು ನಾನೇ ॥ 9 ॥","ಬಡ ರಾವಣನೆ ನಿನ್ನ ಬಡಿದು ಹಾಕುವೆನೋ","ಒಡೆಯನಪ್ಪಣೆಯಿಲ್ಲ ಎಂದು ತಾಳಿದೆನೋ","ಹುಡಿಯೇಳಿಸುವೆನೋ ಖುಲ್ಲ ರಕ್ಕಸನೆ","ತೊಡೆವೆನೋ ನಿನ್ನ ಪಣೆಯ ಅಕ್ಷರವ ॥ 10 ॥","ನಿನ್ನಂಥ ದೂತರು ರಾಮನ ಬಳಿಯೊಳು","ಇನ್ನೆಷ್ಟು ಮಂದಿ ಉಂಟು ಹೇಳೋ ನೀ ತ್ವರಿಯ","ನನ್ನಂಥ ದೂತರು ನಿನ್ನಂಥ ಪ್ರೇತರು","ಇನ್ನೂರು ಮುನ್ನೂರು ಕೋಟಿ ಕೇಳರಿಯಾ ॥ 11 ॥","ಕಡು ಕೋಪದಿಂದಲಿ ಖೂಳ ರಾವಣನು","ಸುಡಿರೆಂದ ಬಾಲವ ಸುತ್ತಿ ವಸನವನು","ಒಡೆಯನ ಮಾತಿಗೆ ತಡೆಬಡೆ ಇಲ್ಲದೆ","ಒಡನೆ ಮುತ್ತಿದರು ಗಡಿಮನೆಯವರು ॥ 12 ॥","ತಂದರು ವಸನವ ತಂಡತಂಡದಲಿ","ಒಂದೊಂದು ಮೂಟೆ ಎಂಭತ್ತು ಕೋಟಿಯಲಿ","ಚಂದದಿ ಹರಳಿನ ತೈಲದೊಳದ್ದಿಸಿ","ನಿಂದ ಹನುಮನು ಬಾಲವ ಬೆಳೆಸುತ ॥ 13 ॥","ಶಾಲು ಸಕಲಾತಿಯು ಸಾಲದೆಯಿರಲು","ಬಾಲೇರ ವಸ್ತ್ರವ ಸೆಳೆದು ತಾರೆನಲು","ಬಾಲವ ನಿಲ್ಲಿಸೆ ಬೆಂಕಿಯನಿಡುತಲಿ","ಕಾಲಮೃತ್ಯುವ ಕೆಣಕಿದರಲ್ಲಿ ॥ 14 ॥","ಕುಣಿಕುಣಿದಾಡುತ ಕೂಗಿ ಬೊಬ್ಬಿಡುತ","ಇಣಿಕಿನೋಡುತ ಅಸುರರನಣಕಿಸುತ","ಝಣಝಣಝಣರೆನೆ ಬಾಲದ ಗಂಟೆಯು","ಮನದಿ ಶ್ರೀ ರಾಮರ ಪಾದವ ನೆನೆಯುತ ॥ 15 ॥","ಮಂಗಳಂ ಶ್ರೀರಾಮಚಂದ್ರಮೂರುತಿಗೆ","ಮಂಗಳಂ ಸೀತಾದೇವಿ ಚರಣಂಗಳಿಗೆ","ಮಂಗಳವೆನುತ ಲಂಕೆಯಸುಟ್ಟು","ಲಂಘಿಸಿ ಅಸುರನ ಗಡ್ದಕೆ ಹಿಡಿದ ॥ 16 ॥","ಹತ್ತಿತು ಅಸುರನ ಗಡ್ಡ ಮೀಸೆಗಳು","ಸುತ್ತಿತು ಹೊಗೆ ಬ್ರಹ್ಮಾಂಡ ಕೋಟಿಯೊಳು","ಚಿತ್ತದಿ ರಾಮರು ಕೋಪಿಸುವರು ಎಂದು","ಚಿತ್ರದಿ ನಡೆದನು ಅರಸನಿದ್ದೆಡೆಗೆ ॥ 17 ॥","ಸೀತೆಯ ಕ್ಷೇಮವ ರಾಮರಿಗ್ಹೇಳಿ","ಪ್ರೀತಿಯಿಂ ಕೊಟ್ಟ ಕುರುಹ ಕರದಲ್ಲಿ","ಸೇತುವೆ ಕಟ್ಟಿ ಚದುರಂಗ ಬಲಸಹ","ಮುತ್ತಿತು ಲಂಕೆಯ ಸೂರೆಗೈಯುತಲಿ ॥ 18 ॥","ವೆಗ್ಗಳವಾಯಿತು ರಾಮರ ದಂಡು","ಮುತ್ತಿತು ಲಂಕೆಯ ಕೋಟೆಯ ಕಂಡು","ಹೆಗ್ಗದ ಕಾಯ್ವರ ನುಗ್ಗು ಮಾಡುತಿರೆ","ಝಗ್ಗನೆ ಪೇಳ್ದರು ರಾವಣಗಂದು ॥ 19 ॥","ರಾವಣ ಮೊದಲಾದ ರಾಕ್ಷಸರ ಕೊಂದು","ಭಾವಶುದ್ಧದಲಿ ವಿಭೀಷಣ ಬಾಳೆಂದು","ದೇವಿ ಸೀತೆಯನೊಡಗೊಂಡಯೋಧ್ಯದಿ","ದೇವ ಶ್ರೀರಾಮರು ರಾಜ್ಯವಾಳಿದರು ॥ 20 ॥","ಶಂಖದೈತ್ಯನ ಕೊಂದೆ ಶರಣು ಶರಣಯ್ಯ","ಶಂಖಗಿರಿಯಲಿ ನಿಂದೆ ಹನುಮಂತರಾಯ","ಪಂಕಜಾಕ್ಷ ಹಯವದನನ ಕಟಾಕ್ಷದಿ","ಬಿಂಕದಿ ಪಡೆದೆಯೋ ಅಜನಪದವಿಯ ॥ 21 ॥"]],"transliteration":[["Eshtu sahasavanta nine balavanta","ditta muruti bhalire bhalire hanumanta /pa/"],["Attuva Kalarede metti tulidu tale","kutti chendadida ditta ninahudo ||a.pa||"],["Ramarappaneyinda sharadhiya dati","a maha lankeya kande kiriti","svami karyava premadi nadeside","i mahiyolu ninagarai sati |1|"],["Duradindasurana puravane nodi","bharadi shriramara smaraneya madi","haride harushadi samharisi lankiniyanu","varijamukiyanu kandu matadi |2|"],["Ramara kshemava ramanige peli","taamasa maadade mudrike nidi","premadim jaanaki kuruhanu kodalagaa","maha vanadolu phalavanu bedi |3|"],["Kannige priyavada hannanu koydu","hannina nevadali asurara hoydu","pannapannane hari negenegedaduta","bannisi asurara balavanu muridu |4|"],["Shrungara vanadolage idda rakkasara","angavanaliside atiranashura","nungi astragala akshaya kuvarana","bhangisi bisutiyo banda rakkasara|5|"],["Duru pelidarella ravananodane","chirutta karesida indrajituvane","Chorakapiyanu ni hiditahudennuta","shurara kaluhida nijasutanodane|6|"],["Pididanu indrajitu kadukopadinda","hedemuri kattida brahmastradinda","guduguduguttuta kidikidiyaguta","nadedanu lankeya odeyaniddedege|7||"],["Kandanu ravananuddanda kapiyanu","mandeya tugutta matadisidanu","bhandu madade 