dale tandu sakala bhutalava |","kshetradindudbhavisi moreyiduva balakana bhitiyanu bidisi nere kaida raghurama ||"],["Baliyoldqnava bedi nelana iradi madi chaladinda kshatriyarkulava hogadi","lalanegosuga banda nevadinda ravanana |talegalanu chendadi mereda raghurama ||"],["Vasudeva sutanenisi vaniteyara vrata gedisi |eseva turagavaneri mallaranu savari |","vasudheyolu purandara ni palisai bishajakshayodhyapura vaasa raghurama ||"]],"aligned":true,"video":"B48P4KFAuAw","videos":["B48P4KFAuAw"],"sourceUrl":"https://bhakthilahari.com/2021/03/15/%e0%b2%9c%e0%b2%af%e0%b2%a4%e0%b3%81-%e0%b2%95%e0%b3%8b%e0%b2%a6%e0%b2%82%e0%b2%a1%e0%b2%b0%e0%b2%be%e0%b2%ae-jayatu-kodanda-rama/"},{"slug":"naa-ninna-dasanayya-seetarama","titleKn":"ನಾ ನಿನ್ನ ದಾಸನಯ್ಯ ಸೀತಾರಾಮ","titleEn":"Naa ninna dasanayya seetarama","form":"song","composer":null,"ankita":null,"raga":null,"tala":null,"stanzas":[["ನಾ ನಿನ್ನ ದಾಸನಯ್ಯ ಸೀತಾರಾಮ ನಾ ನಿನ್ನ ದಾಸನಯ್ಯಾ","ನಾನು ನಿನ್ನಯ್ಯ ದಾಸನಹುದು ನೀನು ಇ ಜಗಧೀಶನಹುದು","ಬಾನುಕೋಟಿ ಪ್ರಕಾಶನೆ ಸಂಗೀತನಾದ ವಿನೋದ ರಂಗಾ","||ನಾ ನಿನ್ನ||"],["ಮತಿಹೀನ ನಾನಾದೆನಯಿ ಶಾಶ್ವತ ಸದ್ಗತಿಯ ನೋಡದೆ ಪೋದೆನೆ","ಹಿತವ ಪಾಲಿಸಬೇಕು ಶ್ರೀ ಪತಿತ ಪಾವನ ರಂಗನಾಯಕ |","ಸತಿ ಶಿರೋಮಣಿ ಪರಮ ಸೀತಾಪತಿಯ ನಾಮದ ಸುತನು ಕಾಣೆ ||ನಾ ನಿನ್ನ||"],["ಕಂದಯ್ಯಗಾರು ಗತಿ ನಿನ್ನಯ ಚೆಲ್ವ ಚೆಂದಪಾದವೆ ಶ್ರತಿ","ಹಿಂದೆ ಮಾಡಿದ ಪಾಪವೆಲ್ಲ ಮುಂದೆ ಬಾರದಂತೆ ಅರಿಯೆ ||","ಇಂದಿರೇಶ ಮುಕುಂದ ಪರಮಾನಂದ ಕುಲಶ್ರೀ ರಾಮದೇಶಿಕ","||ನಾ ನಿನ್ನ||"]],"transliteration":[["Naa ninna dasanayya seetarama naa ninna dasanayya","nanu ninnayya dasanahudu neenu ee jagadeeshanahudu","banukoti prakashane sangeetanada vinoda ranga || naa ninna ||"],["Matiheena nanadenai shashvata sadgatiya nodade podene","hitava palisabeku sri patita pavana ranganayaka","sati shiromani parama seetapatiya namada sutanu kane || naa ninna ||"],["kandayyagaru gati ninnaya chelva chendapadave shruti","hinde madida papavella munde baradante ariye","indiresha mukunda paramananda kulashri ramadeshika || naa ninna ||"]],"aligned":true,"video":"rV0e2NPitDE","videos":["rV0e2NPitDE"],"sourceUrl":"https://bhakthilahari.com/2022/11/02/%e0%b2%a8%e0%b2%be-%e0%b2%a8%e0%b2%bf%e0%b2%a8%e0%b3%8d%e0%b2%a8-%e0%b2%a6%e0%b2%be%e0%b2%b8%e0%b2%a8%e0%b2%af%e0%b3%8d%e0%b2%af-%e0%b2%b8%e0%b3%80%e0%b2%a4%e0%b2%be%e0%b2%b0%e0%b2%be%e0%b2%ae-naa-n/"},{"slug":"ninna-angaladolage-hidi-anna","titleKn":"ನಿನ್ನ ಅಂಗಳದೊಳಗೆ ಹಿಡಿ ಅನ್ನ","titleEn":"Ninna angaladolage hidi anna","form":"song","composer":null,"ankita":null,"raga":null,"tala":null,"stanzas":[["ನಿನ್ನ ಅಂಗಳದೊಳಗೆ ಹಿಡಿ ಅನ್ನ ಹಾಕೋ","ಘನ್ನ ಶ್ರೀ ಗುರುರಾಘವೇಂದ್ರ ಸಂಪನ್ನ ।।ಪ ।।"],["ವರುಷ ವರುಷಕೆ ನಿನ್ನ ದರುಶನವ ದಯಾ ಮಾಡೋ","ದುರಿತ ನಾಶನ ಗೈದು ಪರಿಶುದ್ಧಗೊಳಿಸೋ","ಅರಿತು ಅರಿಯದೆ ಗೈವ ಪಾಪ ಕರ್ಮವ ಕಳೆದು","ನಿರುತ ಶ್ರೀಹರಿ ಕೃಪೆಗೆ ಪಾತ್ರನಾಗಿರಿಸೋ ।।೧।।"],["ನಿನ್ನ ಭಕುತರ ಪಾದ ರಜದೊಳಿದಾಡಿಸೋ","ನಿನ್ನ ಗುಣ ಕೀರ್ತನೆಯ ಕಿವಿಗಳಲಿ ನಿಲಿಸೋ","ನಿನ್ನ ಪಾದೋದಕದಿ ಪಾವನ್ನ ಮಾಡೆನ್ನ","ನಿನ್ನ ರಘುಪತಿ ದಿವ್ಯ ದರುಶನವ ಕೊಡಿಸೋ ।।೨।।"],["ಮಂತ್ರ ಸದನದಿ ನಿನ್ನ ಸಂತಸ ಮಹೋತ್ಸವದಿ","ಶಾಂತಿ ಸುಖ ಸಂಭ್ರಮದಿ ಸನ್ನಿಧಿಯೊಳಿರಿಸೋ","ಸಂತ ಶರಣರ ಭಕುತಿ ನೃತ್ಯಗೀತಗಳ ನೋಡಿ","ನಲಿಯುವ ಭಾಗ್ಯ ಕೊಡು ಎನಗೆ ಪ್ರಭುವೇ ।।೩।।"],["ಪ್ರಲ್ಹಾದ ರಾಯನೀ ಬಲ್ಲಿದನು ಜಗದೊಳಗೆ","ಕಾಯ್ವ ನರಹರಿ ದೂತಾನಹುದೋ","ಎಲ್ಲ ರಾಜರ ರಾಜ ವ್ಯಾಸರಾಯನೇ ಸತ್ಯ","ಇಲ್ಲಿ ಶ್ರೀ ಪರಿಮಳರಾಯರ ಮಹಿಮೆಯೇ ಸ್ತುತ್ಯ ।।೪।।"],["ಏನು ಬೇಡಲಿ ನಾನು ದಾನ ಕರ್ಣನು ನೀನು","ಜ್ಞಾನಿ ಸದ್ಗುರು ಕಲ್ಪವೃಕ್ಷ ಸುರಧೇನು","ದೀನ ರಕ್ಷಕ ವಿಠಲೇಶ ಕರುಣಾಭರಣ","ಸಾನುರಾಗದಿ ನಿನ್ನ ಸೇವಕರೊಳಿರಿಸೋ।।೫।।"]],"transliteration":[["Ninna angaladolage hidi anna haako","ghanna shree gururaaghavendra sampanna || pa ||"],["Varusha varushake ninna darushanava daya maado |","durita naashanagaidu parishuddhagoliso|","Aritu ariyade gaiva paapa karmava kaledu |","niruta shree harikrupege paatranaagiriso || 1 ||"],["Ninna bhakutara paada rajadolidaadiso |","ninna guna keertaneya kivigalali niliso |","ninna paadodakadi paavanna maadenna |","ninna raghupati divya darushanava kodiso || 2 ||"],["Mantra sadanadi ninna santasa mahotsavadi |","shaanti sukha sambhramadi sannidhiyoliriso |","santa sharanara bhakuti nrutyageetegala |","nodi naliyuva bhaagya kodu enage prabhuve || 3 ||"],["Pralhaadaraaya nee ballidanu jagadolage |","nillade kayva narahari dootanahudo |","ella rajara raaja vyasaraayane satya |","illi shree parimalaaryara mahime stutya || 4 ||"],["Enu bedali naanu daani karnane neenu|","jnaani sadguru kalpavruksha suradhenu |","deena rakshaka viththalesha karunaabharana |","saanuraagadi ninna sevakaroliriso || 5 ||"]],"aligned":true,"video":"WAsnOjeq4t0","videos":["WAsnOjeq4t0"],"sourceUrl":"https://bhakthilahari.com/2021/01/11/%e0%b2%a8%e0%b2%bf%e0%b2%a8%e0%b3%8d%e0%b2%a8-%e0%b2%85%e0%b2%82%e0%b2%97%e0%b2%b3%e0%b2%a6%e0%b3%8a%e0%b2%b3%e0%b2%97%e0%b3%86-%e0%b2%b9%e0%b2%bf%e0%b2%a1%e0%b2%bf-%e0%b2%85%e0%b2%a8%e0%b3%8d/"},{"slug":"poojisalende-hoogala","titleKn":"ಪೂಜಿಸಲೆಂದೇ ಹೂಗಳ ತಂದೆ","titleEn":"Poojisalende hoogala","form":"song","composer":null,"ankita":null,"raga":null,"tala":null,"stanzas":[["ಪೂಜಿಸಲೆಂದೇ ಹೂಗಳ ತಂದೆ","ಪೂಜಿಸಲೆಂದೇ ಹೂಗಳ ತಂದೆ","ದರುಶನ ಕೋರಿ ನಾ ನಿಂದೇ…","ತೆರೆಯೋ ಬಾಗಿಲನು ರಾಮ…","ತೆರೆಯೋ ಬಾಗಿಲನು ರಾಮ…"],["ಪೂಜಿಸಲೆಂದೇ ಹೂಗಳ ತಂದೆ"],["ಮೋಡದಮೇಲೆ ಚಿನ್ನದ ನೀರು","ಚೆಲ್ಲುತ ಸಾಗಿದೆ ಹೊನ್ನಿನ ತೇರು","ಮಾಣಿಕ್ಯದಾರತಿ…..ಆ…..ಅ…..","ಮಾಣಿಕ್ಯದಾರತಿ ಉಷೆತಂದಿಹಳು","ತಾಮಸವೇಕಿನ್ನು ಸ್ವಾಮಿ….","ತೆರೆಯೋ ಬಾಗಿಲನು ರಾಮ"],["ಪೂಜಿಸಲೆಂದೇ ಹೂಗಳ ತಂದೆ","ದರುಶನ ಕೋರಿ ನಾ ನಿಂದೇ…","ಪೂಜಿಸಲೆಂದೇ ಹೂಗಳ ತಂದೆ"],["ಒಲಿದರು ಚೆನ್ನ ಮುನಿದರು ಚೆನ್ನ","ನಿನ್ನಾಸರೆಯೇ ಬಾಳಿಗೆ ಚೆನ್ನ","ನಾ ನಿನ್ನ ಪಾದದ ಧೂಳಾದರೂ ಚೆನ್ನ – 2","ಸ್ವೀಕರಿಸು ನನ್ನಾ…ಸ್ವಾಮಿ","ತೆರೆಯೋ ಬಾಗಿಲನು ರಾಮ….."],["ಪೂಜಿಸಲೆಂದೇ ಹೂಗಳ ತಂದೆ","ದರುಶನ ಕೋರಿ ನಾ ನಿಂದೇ…","ತೆರೆಯೋ ಬಾಗಿಲನು ರಾಮ"],["ಪೂಜಿಸಲೆಂದೇ ಹೂಗಳ ತಂದೆ…."]],"transliteration":[["Poojisalende hoogala tande","Poojisalende hoogala tande","Darushana kori na ninde","Tereyo Bagilanu Rama","Tereyo Bagilanu Rama","Poojisalende hoogala tande"],["Moodada mele chinada Neeru , chelutha sagide honnina theru","Moodada mele chinada Neeru , chelutha sagide honnina theru","Manikyadarathi aaaaa..","Manikyadarathi Ushe tandihalu","tamasvekinu swami","Tereyo Bagilanu Rama","Poojisalende hoogala tande","Darushana kori na ninde","Poojisalende hoogala tande"],["Oolidaru chenna ,Munidaru chenna ,ninna asareye balige chenna","Oolidaru chenna ,Munidaru chenna ,ninna asareye balige chenna","na ninna padada dhooladaru chenna","na ninna padada dhooladaru chenna","swikarisu nannaa swami","Tereyo Bagilanu Rama","Poojisalende hoogala tande","Darushana kori na ninde","Tereyo Bagilanu Rama","Poojisalende hoogala tande"],["Video link : sung by S.Janaki from the film Eradu Kanasu https://youtu.be/aG–PhHEy6Y"]],"aligned":false,"video":null,"videos":[],"sourceUrl":"https://bhakthilahari.com/2020/07/05/%e0%b2%aa%e0%b3%82%e0%b2%9c%e0%b2%bf%e0%b2%b8%e0%b2%b2%e0%b3%86%e0%b2%82%e0%b2%a6%e0%b3%87-%e0%b2%b9%e0%b3%82%e0%b2%97%e0%b2%b3-%e0%b2%a4%e0%b2%82%e0%b2%a6%e0%b3%86-poojisalende-hoogala/"},{"slug":"raa-enda-matradolu-rakta","titleKn":"ರಾ ಎಂದ ಮಾತ್ರದೊಳು","titleEn":"Raa enda matradolu rakta","form":"song","composer":null,"ankita":null,"raga":null,"tala":null,"stanzas":[["ರಾ ಎಂದ ಮಾತ್ರದೊಳು ರಕ್ತ ಮಾಂಸದೊಳಿದ್ದಾ","ಆಯಸ್ತವಾದ ಅತಿ ಪಾಪವನೂ ಮಾಯ ಮಾಡಿ, ಮತ್ತೆ ಮಾ ಎಂದೆನಲು","ಹೊರಬಿದ್ದ ಪಾಪಗಳು ಒತ್ತಿ ಒಳ ಪೋಗದಂತೇ…ಏ…","ಕವಾಟವಾಗಿ ಕಾಯ್ವ ಮಂತ್ರಾ…..ಆ…"],["ಶ್ರೀ ರಾಮ ಜಯ ರಾಮ ರಮಣೀಯ ನಾಮ ರಘುರಾಮ ||2||","ರಾಮ ಮಂತ್ರವ ಜಪಿಸೀ ಪಾಪವ ಕಳೆಯೋಣ ||","ರಘುಕುಲತಿಲಕನ ಚರಣಕ್ಕೆರಗಿ ಪುನೀತರಾಗೋಣ"],["ಅಗಣಿತ ಗುಣ ಗಣ ಶ್ರೀ ರಾಮ ಆಶ್ರೀತ ವತ್ಸಲ ಶ್ರೀ ರಾಮ","ದೀನದಯಾಳು ಶ್ರೀ ರಾಮ ಹರಿ ಸರ್ವೋತ್ತಮ ಶ್ರೀ ರಾಮ","ದಶಮುಖ ಮರ್ದನ, ದಶರಥ ರಾಮ ಮಾರುತಿ ಸೇವಿತ ಶ್ರೀ ರಾಮ","ರಾಮಚಂದ್ರ ಪ್ರಭು ‌ ||ರಾಮ ಮಂತ್ರವ||"],["ಜಾನಕಿ ಮನೋಹರ ಜ್ಞಾನಧಾತ ಕರುಣಾಸಾಗರ ಕೋದಂಡರಾಮಾ..","ಭಕ್ತಿಪ್ರಿಯನಿಧಿ ,ಮುಕ್ತಿದಾಯಕ ಭಕ್ತಜನ ಶ್ರೀ ಮಂದಾರನೇ","ರಾಮ ಎಂಬುವ ಎರಡು ಅಕ್ಷರದ ಮಹಿಮೆಯ |","ಪಾಮರರು ನಾವು ಬಲ್ಲೆವೇನು ||"],["ರಾಮ ರಾಮ ರಾಮ ರಾಮ ರಾಮ ರಾಮ ರಾಮ","ರಾಮ ರಾಮ ರಾಮ ರಾಮ ರಾಮ ರಾಮ ರಾಮ","ರಾಮ ರಾಮ ರಾಮ ರಾಮ ರಾಮ ರಾಮ ರಾಮ","ರಾಮಚಂದ್ರ ಪ್ರಭು ||ರಾಮ ಮಂತ್ರವ||"],["ಧರೆಯೊಲಿ ನಾಮಕೆ ಸರಿಸಾಟಿ ಇಲ್ಲವೆಂದು","ಪರಮ ವೇದಗಳೆಲ್ಲ ಪೊಗಳುತಿವೆ","ಚಿತ್ತ ಕಾಯಗಳ ಪವಿತ್ರ ಪಾದೋದಕವ ಭಕ್ತವರ ಹನುಮಂತನೊಬ್ಬ ತಾ ಬಲ್ಲ","ರಾಮ ಗೋವಿಂದ ಹರೇ ಕ್ರಷ್ಣ ಗೋವಿಂದ","ರಾಮ ಗೋವಿಂದ ಹರೇ ಕ್ರಷ್ಣ ಗೋವಿಂದ","ಶಂಖಚಕ್ರ ಧರಾ ವಿಷ್ಣು ಮುಕುಂದ ||"],["ರಾಮ ರಾಮ ರಾಮ ರಾಮ ರಾಮ ರಾಮ ರಾಮ","ರಾಮ ರಾಮ ರಾಮ ರಾಮ ರಾಮ ರಾಮ ರಾಮ","ರಾಮ ರಾಮ ರಾಮ ರಾಮ ರಾಮ ರಾಮ ರಾಮ","ರಾಮಚಂದ್ರ ಪ್ರಭು ||ರಾಮ ಮಂತ್ರವ||"]],"transliteration":[["Raa enda matradolu rakta mamsadoliddaa","ayastavada ati papavanoo maya madi, matte maa endenalu","hobidda paapagalu otti ola pogadante …","kavaatavagi kayva mantra ……."],["Sri rama jaya rama ramaneeya nama raghurama","rama mantrava japisi paapava kaleyona ||","raghukulatilakana charanakkeragi puneetaragona"],["Aganita gunagana sri rama ashrita vatsala sri rama","deenadayalu sri rama hari sarvottama sri rama","dashamukha mardhana, dasharatha rama maruti sevita sri rama","ramachandra prabhu || rama mantrava ||"],["Janaki manohara jnanadaata karunasagara kodandarama","bhaktipriyanidhi muktidayaka bhaktajana sri mandarane","rama embuva eradu aksharada mahimeya|","pamararu navu ballevenu ||"],["Rama rama rama rama rama rama rama","rama rama rama rama rama rama rama","rama rama rama rama rama rama rama","ramachandra prabhu || rama mantrava ||"],["Dhareyoli namake sarisati illavendu","parama vedagalella pogalutive","chitta kayagala pavitra paadodakava","bhaktavara hanumantanobba taa balla","rama govinda hare krishna govinda hare","rama govinda hare krishna govinda hare","shankhachakradhara vishnu mukunda ||"],["Rama rama rama rama rama rama rama","rama rama rama rama rama rama rama","rama rama rama rama rama rama rama","ramachandra prabhu || rama mantrava ||"]],"aligned":true,"video":"2A5DyQj8DGo","videos":["2A5DyQj8DGo"],"sourceUrl":"https://bhakthilahari.com/2022/08/26/%e0%b2%b0%e0%b2%be-%e0%b2%8e%e0%b2%82%e0%b2%a6-%e0%b2%ae%e0%b2%be%e0%b2%a4%e0%b3%8d%e0%b2%b0%e0%b2%a6%e0%b3%8a%e0%b2%b3%e0%b3%81-raa-enda-matradolu-rakta/"},{"slug":"raama-naama-paayasakke","titleKn":"ರಾಮನಾಮ ಪಾಯಸಕ್ಕೆ","titleEn":"Raama naama paayasakke","form":"pada","composer":"purandara-dasa","ankita":"ಪುರಂದರ ವಿಠಲ","raga":null,"tala":null,"stanzas":[["ರಾಮನಾಮ ಪಾಯಸಕ್ಕೆ ಕೃಷ್ಣನಾಮ ಸಕ್ಕರೆ","ವಿಠಲನಾಮ ತುಪ್ಪವ ಬೆರೆಸಿ ಬಾಯಿ ಚಪ್ಪರಿಸಿರೊ||pa||"],["ಒಮ್ಮನ ಗೋಧಿಯ ತಂದು ವೈರಾಗ್ಯ ಕಲ್ಲಲಿ ಬೀಸಿ","ಸುಮ್ಮನ ಸಜ್ಜಿಗೆ ತೆಗೆದು ಸಣ್ಣ ಸೇವೆಗೆ ಹೊಸೆದು|"],["ಹೃದಯವೆಂಬೊ ಪಾತ್ರೆಯೊಳಗೆ ಭಾವವೆಂಬೊ ಎಸರು ಇಟ್ಟು","ಬುದ್ದಿಯಿಂದ ಪಕ್ವವ ಮಾಡಿ ಹರಿವಾಣದೊಳಗೆ ನೀಡಿ|"],["ಆನಂದ ಆನಂದವೆಂಬೊ ತೇಗು ಬಂದ ಪರಿಯಲಿ","ಆನಂದಮೂರುತಿ ನಮ್ಮ ಪುರಂದರವಿಠಲ ನೆನೆಯಿರೊ||"]],"transliteration":[["Song is composed by Sri Purandara daasaru. The english lyrics for this song"],["Raama naama paayasakke krishnanaama sakkare | Vithalanaama tuppava kalasi baayi chapparisiro ||pa||"],["Ommaana godhiya tandu vairaagya kallili bisi | Summane sajjigeya tegedu sanna shaavigeya hosedu ||1||"],["Hrudayavembo madakeyalli bhaavavembo esaranittu |Buddhiyinda paakamaadi harivaanake badisikondu ||2||"],["Aananda aanandavembo tegu banditu kaniro | aananda muruti namma purandara vithalana neneyiro ||3||"],["Youtube link here : by priya sisters https://youtu.be/PIHcZjc5Z8s"]],"aligned":false,"video":null,"videos":[],"sourceUrl":"https://bhakthilahari.com/2020/07/10/%e0%b2%b0%e0%b2%be%e0%b2%ae%e0%b2%a8%e0%b2%be%e0%b2%ae-%e0%b2%aa%e0%b2%be%e0%b2%af%e0%b2%b8%e0%b2%95%e0%b3%8d%e0%b2%95%e0%b3%86-raama-naama-paayasakke/"},{"slug":"rama-mantrava-japiso","titleKn":"ರಾಮ ಮಂತ್ರವ ಜಪಿಸೋ","titleEn":"Rama mantrava japiso","form":"pada","composer":"purandara-dasa","ankita":"ಪುರಂದರ ವಿಠಲ","raga":null,"tala":null,"stanzas":[["ರಾಮ ಮಂತ್ರವ ಜಪಿಸೋ – ರಾಗ : ಮಧ್ಯಮವತಿ. ಆದಿ ತಾಳ. ಪುರಂದರದಾಸರು"],["ರಾಮ ಮಂತ್ರವ ಜಪಿಸೋ ಹೇ ಮನುಜ|| ಪ ||"],["ಆ ಮಂತ್ರ ಈ ಮಂತ್ರ ನೆಚ್ಚಿ ನೀ ಕೆಡಬೇಡ","ಸೋಮಶೇಖರ ತನ್ನ ಸತಿಗೆ ಪೇಳಿದ ಮಂತ್ರ|| ಅ.ಪ ||"],["ಕುಲಹೀನನಾದರು ಕೂಗಿ ಜಪಿಸುವ ಮಂತ್ರ","ಸಲೆ ಬೀದಿ ಬೀದಿಯೊಳು ನುಡಿವ ಮಂತ್ರ |","ಹಲವು ಪಾಪಂಗಳ ಹತಗೊಳಿಸುವ ಮಂತ್ರ","ಸುಲಭದಿಂದಲಿ ಸ್ವರ್ಗ ಸೂರೆಗೊಂಬುವ ಮಂತ್ರ || ೧ ||"],["ಸ್ನಾನ ಮೌನಂಗಳಿಗೆ ಸಾಧನದ ಮಂತ್ರ","ಜ್ಞಾನಿಗಳು ಮನದಿ ಧ್ಯಾನಿಪ ಮಂತ್ರ |","ಹೀನ ಗುಣಂಗಳ ಹಿಂಗಿಸುವ ಮಂತ್ರ","ಏನೆಂಬೆ ವಿಭೀಷಣಗೆ ಪಟ್ಟಗಟ್ಟಿದ ಮಂತ್ರ || ೨ ||"],["ಸಕಲ ವೇದಂಗಳಿಗೆ ಸಾರವೆನಿಪ ಮಂತ್ರ","ಮುಕುತಿ ಮಾರ್ಗಕೆ ಇದೆ ಮೂಲ ಮಂತ್ರ |","ಭಕುತಿ ರಸಕೆ ಬಟ್ಟೆ ಒಮ್ಮೆ ತೋರುವ ಮಂತ್ರ","ಸುಖ ನಿಧಿ ಪುರಂದರ ವಿಠಲನ ಮಂತ್ರ|| ೩ ||"]],"transliteration":[["Rama mantrava japiso composed by Purandaradasa."],["Rama mantrava japiso he manuja","A mantra ee mantra nechi ni kedabeda","somashekhara tanna bhamegelida mantra"],["kula hinanadarau kugi japisuva mantra","sale bidiyolu ucharipa mantra","halavu papangala hadagedisuva mantra","sulabhadindali svarga sure kombuva mantra||1||"],["Snaana mounangalige saadhanada mantra","jnaanigalu manadi dhyaanipa mantra |","heena gunangala hingisuva mantra,","enembe vibhishanage pattagattida mantra ||2||"],["Sakala vedangalige saaravenipa mantra","mukuti maargake ede moola mantra |","bhakuti rasake batte omme toruva mantra,","sukha nidhi purandara vittalana mantra ||3||"],["Click the link to listen song"]],"aligned":true,"video":"WzQBGpuAEj0","videos":["WzQBGpuAEj0"],"sourceUrl":"https://bhakthilahari.com/2020/05/31/%e0%b2%b0%e0%b2%be%e0%b2%ae-%e0%b2%ae%e0%b2%82%e0%b2%a4%e0%b3%8d%e0%b2%b0%e0%b2%b5-%e0%b2%9c%e0%b2%aa%e0%b2%bf%e0%b2%b8%e0%b3%8b-rama-mantrava-japiso/"},{"slug":"rama-rama-ram-ram","titleKn":"ರಾಮ ರಾಮ ರಾಮ್ ರಾಮ್","titleEn":"Rama rama ram ram","form":"song","composer":null,"ankita":null,"raga":null,"tala":null,"stanzas":[["ರಾಮ ರಾಮ ರಾಮ್ ರಾಮ್ ರಾಮ್ ಜಯ ರಾಮ ರಾಮ ರಾಮ್ ರಾಮ್ ರಾಮ್ | ೨ಸಲ|"],["ದಶರಥ ನಂದನ ರಾಮ್ ರಾಮ್ ರಾಮ್ ದಶಮುಖ ಮರ್ದನ ರಾಮ್ ರಾಮ್ ರಾಮ್ |೨ಸಲ ಪಶುಪತಿ ರಂಜನ ರಾಮ್ ರಾಮ್ ರಾಮ್ ಪಾಪ ವಿಮೋಚನ ರಾಮ್ ರಾಮ್ ರಾಮ್ |೨ಸಲ|"],["ರಾಮ ರಾಮ ರಾಮ್ ರಾಮ್ ರಾಮ್ ಜಯ ರಾಮ ರಾಮ ರಾಮ್ ರಾಮ್ ರಾಮ್ | ೨ಸಲ|"],["ಅನಾಥ ರಕ್ಷಕ ರಾಮ್ ರಾಮ್ ರಾಮ್ ಆಪತ್ಬಾಂಧವ ರಾಮ್ ರಾಮ್ ರಾಮ್ |೨ಸಲ|}ಮೈಥಿಲಿ ನಂದನ ರಾಮ್ ರಾಮ್ ರಾಮ್ ಮಾರುತಿ ವಂದಿತ ರಾಮ್ ರಾಮ್ ರಾಮ್ |೨ಸಲ|"],["ರಾಮ ರಾಮ ರಾಮ್ ರಾಮ್ ರಾಮ್ ಜಯ ರಾಮ ರಾಮ ರಾಮ್ ರಾಮ್ ರಾಮ್ { ೨ಸಲ}"]],"transliteration":[["Rama rama ram ram ram | jaya rama rama ram ram ram ||2times|"],["Dasharatha nandana ram ram ram dashamukha mardhana ram ram ram |2times|pashupati ranjana ram ram ram ||2 times||"],["Rama rama ram ram ram | jaya rama rama ram ram ram ||2times|"],["Anatha rakshaka ram ram ram apatbhandhava ram ram ram |2times| maithili nandana ram ram ram |maruti vandita ram ram ram |2times|"],["Rama rama ram ram ram | jaya rama rama ram ram ram ||2times|"]],"aligned":true,"video":"hZch8NXQa5A","videos":["hZch8NXQa5A"],"sourceUrl":"https://bhakthilahari.com/2021/01/06/%e0%b2%b0%e0%b2%be%e0%b2%ae-%e0%b2%b0%e0%b2%be%e0%b2%ae-%e0%b2%b0%e0%b2%be%e0%b2%ae%e0%b3%8d-%e0%b2%b0%e0%b2%be%e0%b2%ae%e0%b3%8d-rama-rama-ram-ram/"},{"slug":"rama-rama-rama-enniro","titleKn":"ರಾಮ ರಾಮ ರಾಮ ಎನ್ನಿರೋ","titleEn":"Rama rama rama enniro","form":"pada","composer":"purandara-dasa","ankita":"ಪುರಂದರ ವಿಠಲ","raga":null,"tala":null,"stanzas":[["ರಾಮ ರಾಮ ರಾಮ ಎನ್ನಿರೋ ಇಂಥ ಸ್ವಾಮಿಯ","ನಾಮವ ಮರೆಯದಿರೊ ||","||ರಾಮ ರಾಮ||"],["ತುಂಬಿದ ಪಟ್ಟಣಕ್ಕೆ ಒಂಭತ್ತು ಬಾಗಿಲು","ಸಂಭ್ರಮದರಸರು ಐದು ಮಂದಿ |","ಢಂಬಕತನದಿಂದ ತಿರುಗುವ ಕಾಯದಿ","ನಂಬಿ ನೆಚ್ಚಿ ನೀವು ಕೆಡಬೇಡಿರೊ","||ರಾಮ ರಾಮ||"],["ನೆಲೆಯಿಲ್ಲದೀಕಾಯ ಎಲುಬಿನ ಪಂಜರ","ಹೊಲಿದು ಸುತ್ತಿದ ಚರ್ಮದ ಹೊದಿಕೆ ||","ಮಲಮೂತ್ರಂಗಳು ಕೀವು ಕ್ರಿಮಿಗಳಿಂದ","ಭರಿತ ದೇಹವನೆಚ್ಚಿ ಕೆಡಬೇಡಿರೊ","||ರಾಮ ರಾಮ||"],["ಹರಬ್ರಹ್ಮ ಸುರರಿಂದ ವಂದಿತನಾಗಿರ್ಪ","ಹರಿಸರ್ವೋತ್ತಮನೊಬ್ಬ ಕಾಣಿರೊ ||","ಪುರಂದರ ವಿಠಲನ ಭಜನೆಯ ಮಾಡಿರೊ","ದುರಿತ ಪರ್ವತವೆಲ್ಲ ಪರಿಹಾರವೊ","||ರಾಮ ರಾಮ||"]],"transliteration":[["Rama rama rama enniro intha swamiya naamava mareyadiro || rama rama ||"],["Tumbida pattanakke ombattu baagilu sambhramadarasaru idu mandi | dhamkatanadinda tiruguva kaayadi, nambi necchi neevu kedabediro || rama rama ||"],["Neleyilladeekaaya elubina panjara holidu suttida charmada hodike | mala mutrangalu keevu krimigalinda bharita dehavanecchi kedabediro || rama rama ||"],["Harabrahma surarinda vanditanaagirpa hari sarvottamanobba kaaniro | purandara vittalana bhajaneya maadiro durita parvatavella parihaaravo || rama rama ||"]],"aligned":true,"video":"MJwN6Tat1Wo","videos":["MJwN6Tat1Wo"],"sourceUrl":"https://bhakthilahari.com/2022/02/07/%e0%b2%b0%e0%b2%be%e0%b2%ae-%e0%b2%b0%e0%b2%be%e0%b2%ae-%e0%b2%b0%e0%b2%be%e0%b2%ae-%e0%b2%8e%e0%b2%a8%e0%b3%8d%e0%b2%a8%e0%b2%bf%e0%b2%b0%e0%b3%8b-rama-rama-rama-enniro/"},{"slug":"ramadootana-pada-taamarasava-kanda","titleKn":"ರಾಮದೂತನ ಪಾದ ತಾಮರಸವ","titleEn":"Ramadootana pada taamarasava kanda","form":"pada","composer":"gopala-dasa","ankita":"ಗೋಪಾಲ ವಿಠಲ","raga":null,"tala":null,"stanzas":[["ರಾಮದೂತನ ಪಾದ ತಾಮರಸವ ಕಂಡ||2||","ಆ ಮನುಜನೆ ಧನ್ಯನೂ||2||"],["ಶ್ರೀ ಮನೋಹರನಂಘ್ರಿ ಭಜಕ ಸ್ತೋಮ ಕುಮುದಕೆ ಸೋಮನೆನಿಸುವ ಭೂಮಿಯೊಳು ಯದುಗಿರಿಯ ಸೀಮೆಯ ಕಾಮವರದೊಳು ಪ್ರೇಮದಿಂದಿಹ ||ರಾಮ||"],["ಕೋತಿ ರೂಪದಿ ರಘುನಾಥನಾಜ್ಞೆಯ ತಾಳಿ ಪಾದೋದಿಯ ಲಂಘಿಸಿ ||ಕೋತಿ ರೂಪದಿ||","ಖ್ಯಾತ ಲಂಕೆಯ ಪೊಕ್ಕು ಶೋಧಿಸಿ ಮಾತೆಯನ್ನು ಕಂಡೆರಗಿ ದಶಮುಖ ಹೋತ ಖಳಕುಲ ವ್ಯಾತ ಘಾತಿಸಿ ಸೀತೆವಾರ್ತೆಯ ನಾಥಗರುಹಿದ ||ರಾಮ||"],["ಪಾಂಡುಸುತನೆ ಪ್ರಚಂಡ ಗದೆಯನ್ನು ದೋರ್ದಂಡದಿ ಧರಿಸುತಲೀ||ಪಾಂಡುಸುತ||","ಮಂಡಲದೊಳು ಭಂಡ ಕೌರವ ಚಂಡ ರಿಪುಗಳ ಖಂಡಿಸಿ ಶಿರ ಚೆಂಡನಾಡಿ ಸತಿಗೆ ಕರುಳಿನ","ದಂಡೆ ಮುಡಿಸಿದ ಉಧ್ಧಂಡ ವಿಕ್ರಮ ||ರಾಮ||"],["ಧಾರುಣಿಯೊಳು ದ್ವಿಜನಾರಿ ಗರ್ಭದಿ ಬಂದು ಮೂರೊಂದಾಶ್ರಮ ಧರಿಸಿ||ಧಾರುಣಿ||","ಧೀರನೀನೆರದಿಕತ್ರಿದಶ ಸಾರಗ್ರಂಥಗಳವಿರಚಿಸುತ ಮಹಾಶೂರ ಶ್ರೀಗೋಪಾಲವಿಠ್ಠಲನ","ಚಾರು ಚರಣಕೆ ಅರ್ಪಿಸಿದ ಗುರು ||ರಾಮ||"]],"transliteration":[["Ramadootana pada taamarasava kanda||2||a manujane dhanyanoo||2||"],["Sri manoharananghri bhajakastoma kumudake somanenisuva bhumiyolu yadugiriya seemeya kamavaradolu premadindiha||rama||"],["Koti roopadi raghunaatha-naajneya taali paadodiya langhisi ||2 times|| khyata lankeya pokku shodhisi maateyannu kanderagi dashamukha hota khalakula vyaata ghaatisi seetevarteya naathagaruhida ||rama||"],["Paandusutane prachanda gadheyanu dordandadi dharisutali ||2 times || mandaladolu bhanda kourava chanda ripugala khandisi shira chandanaadi satige karulina dande mudisida uddhanda vikrama ||rama ||"],["Dhaaruniyolu dwijanaari garbhadi bandu moorondaashrama dharisi ||2 times|| dheeraneeneradikatridasha saaragranthagala virachisuta mahashura sri gopaalavithalana charu charanake arpisida guru ||rama||"]],"aligned":true,"video":"tBF05N6KX7s","videos":["tBF05N6KX7s"],"sourceUrl":"https://bhakthilahari.com/2021/06/22/%e0%b2%b0%e0%b2%be%e0%b2%ae%e0%b2%a6%e0%b3%82%e0%b2%a4%e0%b2%a8-%e0%b2%aa%e0%b2%be%e0%b2%a6-%e0%b2%a4%e0%b2%be%e0%b2%ae%e0%b2%b0%e0%b2%b8%e0%b2%b5-ramadootana-pada-taamarasava-kanda/"},{"slug":"ramanamavembo-namava-nenedare-bhayavilla","titleKn":"ರಾಮನಾಮವೆಂಬೋ ನಾಮವ ನೆನೆದರೆ ಭಯವಿಲ್ಲ","titleEn":"Ramanamavembo namava nenedare bhayavilla","form":"pada","composer":"purandara-dasa","ankita":"ಪುರಂದರ ವಿಠಲ","raga":null,"tala":null,"stanzas":[["ರಾಮನಾಮವೆಂಬೋ ನಾಮವ ನೆನೆದರೆ","ಭಯವಿಲ್ಲ ಮನಕೆ","ಮೂರು ಲೋಕಕೆ ಕಾರಣ ಕರ್ತಾ","ನಾರಾಯಣ ಜಾಗಕೆ ||ರಾಮ||","ಶ್ರೀಮನ್ ನಾರಾಯಣ ಜಗಕೆ ||೨ || ||ರಾಮ||"],["ಮತ್ಸ್ಯಾವತಾರವ ತಾಳಿದ ರಾಮ","ವೇದವ ತರುವದಕೆ","ಬೆಟ್ಟವ ಬೆನ್ನಲಿ ಪೊತ್ತ ರಾಮ","ಕೂರ್ಮಾವತಾರಕ್ಕೆ ||ರಾಮ ||"],["ಭೂಮಿಯ ಪೊತ್ತು ನೀರೊಳು ಮುಳುಗಿದ","ವರಾಹವತಾರಕ್ಕೆ","ಕರುಳನು ಬಗೆದು ಮಾಲೆಯ ಧರಿಸಿದ","ಪ್ರಹ್ಲಾದನ ಸಲಹುದಕೆ || ರಾಮ||"],["ಭೂಮಿಯ ದಾನವ ಬೇಡಿದ ರಾಮ","ವಾಮನವತಾರಕ್ಕೆ","ತಾಯಿಯ ಶಿರವನು ಕಡಿದನು ರಾಮ","ಭಾರ್ಗವತಾರಕ್ಕೆ || ರಾಮ ||"],["ವನವಾಸವ ಮಾಡಿದ ರಾಮ","ಜನಕನ ವಾಕ್ಯಕ್ಕೆ","ಮಾವ ಕಂಸನ ಕೊಂದನು ಕೃಷ್ಣ","ತಾಯಿಯ ಬಿಡಿಸಲಿಕ್ಕೆ || ರಾಮ ||"],["ಸತಿಯರ ವ್ರತಗಳ ಕೆಡಿಸಿದ ರಾಮ","ತ್ರಿಪುರರ ಸಲಹುದಕ್ಕೆ","ವಾಹನ ಬಿಟ್ಟು ತುರಗವ ನೇರಿದ","ಕಲ್ಯವತಾರಕ್ಕೆ ||ರಾಮ ||"],["ಶ್ಯಾಮಲ ವರ್ಣವ ತಾಳಿದ ರಾಮ","ಸಾಮರ್ಥ್ಯನು ಜಗಕೆ","ಸ್ವಾಮಿ ಶ್ರೀ ಪುರಂದರ ವಿಠಲನು ರಾಮ","ಗೋವಿಂದನು ಜಗಕೆ || ರಾಮ ||"]],"transliteration":[["Ramanamavembo namava nenedare","bhayavilla manake","mooru lokakke karana karta","narayana jagake || Rama ||","shreeman narayana jagake"],["Matsyavatarava talida rama","vedava taruvadake","bettada bennali potta rama","koormavatarakke || Rama ||"],["Bhumiya pottu neerolu mulugida","varahavatarakke","karulanu bagedu maleya dharisida","prahladana salahudake || Rama ||"],["Bhumiya danava bedida rama","vamanavatarakke","tayiya shiravanu kadidanu rama","bhargavatarakke || Rama ||"],["Vanavasava maḍida rama","janakana vakyakke","mava kamsana kondana krishna","tayiya bidisalikke || Rama ||"],["Satiyara vrutagala kedisidane rama","tripurara salahudake","vahana bittu turagava nerida","kalkyavatarakke || rama ||"],["Shyamala varnana talida rama","samarthyanu jagake","swami Shree Purandara vittalanu rama","govindana jagake || Rama ||"]],"aligned":true,"video":"lySgFbkLgqk","videos":["lySgFbkLgqk"],"sourceUrl":"https://bhakthilahari.com/2025/06/21/%e0%b2%b0%e0%b2%be%e0%b2%ae%e0%b2%a8%e0%b2%be%e0%b2%ae%e0%b2%b5%e0%b3%86%e0%b2%82%e0%b2%ac%e0%b3%8b-%e0%b2%a8%e0%b2%be%e0%b2%ae%e0%b2%b5-%e0%b2%a8%e0%b3%86%e0%b2%a8%e0%b3%86%e0%b2%a6%e0%b2%b0%e0%b3%86/"},{"slug":"summane-dorakuvade-shriraamana","titleKn":"ಸುಮ್ಮನೆ ದೊರಕುವದೆ ಶ್ರೀರಾಮನ","titleEn":"Summane dorakuvade shriraamana","form":"pada","composer":"purandara-dasa","ankita":"ಪುರಂದರ ವಿಠಲ","raga":null,"tala":null,"stanzas":[["ಸುಮ್ಮನೆ ದೊರಕುವದೆ ಶ್ರೀರಾಮನ ದಿವ್ಯನಾಮವು","ಜನ್ಮಜನ್ಮಾಂತರದ ದುಷ್ಕರ್ಮ ಹೋದವಗಲ್ಲದೆ ||"],["ಕಂತುಪಿತನ ಮೂರುತಿಯ ತನ್ನಂತರಂಗದೊಳಿಟ್ಟು","ಚಿಂತೆ ಎಲ್ಲ ಬಿಟ್ಟು ನಿಶ್ಚಿಂತನಾದವಗಲ್ಲದೆ ||"],["ಭಕ್ತಿ ರಸದಲ್ಲಿ ತನ್ನು ಚಿತ್ತ ಪರವಶನಾಗಿ","ಅಚ್ಯುತನ ನಾಮವನು ಬಚ್ಚಿಟ್ಟುಕೊಂಡವಗಲ್ಲದೆ ||"],["ತನ್ನೊಳಗೆ ಇದ್ದ ಮೂರುತಿಯ ಕಣ್ಣೊಳಗೆ ತಂದರೆ","ಆನಂದಪೂರ್ಣ ಪುರಂದರ ವಿಠಲನ ನೋಡಿದಗಲ್ಲದೆ||"]],"transliteration":[["Summane dorakuvade shriraamana divyanaamavu|","janmajanmaantarada dushkarma hodavagallade||"],["Kantupitana moorutiya tannantarangadolittu|","chinte ella bittu nishchintanaadavagallade||"],["Bhakti rasadalli tannu chitta paravashanaagi|","achyutana naamavanu bacchittukondavagallade||"],["Tannolage idda moorutiya kannolage tandare|","aanandapoorna purandara vithalana nodidagallade||"]],"aligned":true,"video":"M-ywdMip8Ig","videos":["M-ywdMip8Ig"],"sourceUrl":"https://bhakthilahari.com/2021/08/05/%e0%b2%b8%e0%b3%81%e0%b2%ae%e0%b3%8d%e0%b2%ae%e0%b2%a8%e0%b3%86-%e0%b2%a6%e0%b3%8a%e0%b2%b0%e0%b2%95%e0%b3%81%e0%b2%b5%e0%b2%a6%e0%b3%86-%e0%b2%b6%e0%b3%8d%e0%b2%b0%e0%b3%80%e0%b2%b0%e0%b2%be%e0%b2%ae/"},{"slug":"tyagaraja-sangeeta-sri-ramanu","titleKn":"ತ್ಯಾಗರಾಜ‌ ಸಂಗೀತ ಶ್ರೀರಾಮನು","titleEn":"Tyagaraja sangeeta sri ramanu","form":"song","composer":null,"ankita":null,"raga":null,"tala":null,"stanzas":[["ತ್ಯಾಗರಾಜ‌ ಸಂಗೀತ ಶ್ರೀರಾಮನು","ಪುರಂದರ ಸಂಗೀತ ಶ್ರೀಕ್ರಷ್ಣನು|","ಸ್ವಾತಿಗೆ ಸಂಗೀತ ಪದ್ಮನಾಭನೂ…|","ಅಖಿಲರ ಸಂಗೀತ ಅಯ್ಯಪ್ಪನೂ…","ಶ್ರೀ ಅಯ್ಯಪ್ಪನೂ…."],["ಸ್ವಾಮಿ ಸಂಗೀತದೊಳ್ ಸಾಮ ಸಂಗೀತದೊಳ್","ಆರೋಹಣ ಶಬರೀಶ್ರಂಗ|","ಆ ಶ್ರಂಗದ ಉತ್ತುಂಗದೊಳ್ ದಾಸನ ಸಪ್ತ ಸ್ವರವಿಹಂಗ","ಸ್ವರರಾಗ ಶ್ರೀ ವಿಹಂಗಾ ||ತ್ಯಾಗರಾಜ||"],["ಸುರಸುತ ಗೀತೆಯೊಳ್ ಸುಗಮ ಸಂಗೀತದೊಳ್","ಅವರೋಹಣ ಪಂಪಾತೀರ್ಥ |","ಅ ತೀರ್ಥದೊಳ್,ಜಲಸಾಗರೆಯೊಳ್","ಅಲೆಯಾಗಿ‌ ಮುಳುಗೆ‌ ಹ್ರದಯಾನಂದ","ಶುಧ್ಧ ಶ್ರತಿಯೊಳು ಆನಂದ ||ತ್ಯಾಗರಾಜ||"]],"transliteration":[["Tyaagaraaja sangeetha sriramanu| purandara sangeeta srikrishnanu| swatige Sangeeta padmanabhanu ….. | Akhilara Sangeeta ayyappanu ….. Sri ayyappanu ……"],["Swami sangeetadol saama sangeetadol |arohana shabari shrunga | a shrungada uttungadol dasana sapta swaravihanga | swara raga sri vihangaa || tyagaraja ||"],["Surasuta geeteyol sugama sangeetadol | avarohana pampateertha | a teerthadol jalasagardol | aleyaagi muluge hrudayaananda | shuddha shrutiyol ananda || tyagaraja ||"]],"aligned":true,"video":"mTHX8Mx5SRs","videos":["mTHX8Mx5SRs"],"sourceUrl":"https://bhakthilahari.com/2022/11/28/%e0%b2%a4%e0%b3%8d%e0%b2%af%e0%b2%be%e0%b2%97%e0%b2%b0%e0%b2%be%e0%b2%9c-%e0%b2%b8%e0%b2%82%e0%b2%97%e0%b3%80%e0%