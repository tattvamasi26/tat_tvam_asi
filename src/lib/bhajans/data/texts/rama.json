ನಾಮ||೫||"],["ಆ ಮಹಾ ಹನುಮನ ಕಾಮಿತದಂತೆ ಮಹೇಂದ್ರ ಸುತ ನ‌ ಕೊಂದ ನಾಮ","ಕೋಮಲಕಮಲ ಸುಯುತತನಯಗೆ ಸಾಮ್ರಾಜ್ಯವನಿತ್ತ ನಾಮ||೬||"],["ಹರಿಪರಿವಾರದಿ ಶರದಿಯೊಳ್ ಸೇತುಬಂದನ ವ ಮಾಡಿದ ನಾಮ","ಧುರಳರಾವಣ ರಕ್ಕಸರನ್ನೆ ಕೊಂದು","ಧರಣಿಸುತೆಯ ತಂದ ನಾಮ||೭||"],["ಶರಣವ ಪೊಂದಿದ ಭಕುತ ವಿಭಿಷಣ ಗೆ ಕರುಣವ ತೋರಿದ ನಾಮ","ಕರುಣಿಸೀತೆ ಲಕ್ಷ್ಮಣನಿಂದ ಕೂಡಿ ಪುಷ್ಪಕವ ನೇರಿದ ಸಾದು ನಾಮ||೮||"],["ಗುರುತರ ತಪದಲಿ ನಿರತನಾಗಿ ತಮ್ಮ ಭರತ ನ ಉಳಿಸಿದ ನಾಮ","ದೊರೆತನ ಪೊಂದಿ ಸಕಲಸುಜನರಿಗೆ ಪರತರ ಸುಖವಿತ್ತ ನಾಮ||೯||"],["ತನ್ನ ಭಕುತರೊಳು ಉನ್ನತನೆಣಿಸಿದ ಘನ್ನ ಮಾರುತಿಗೊಲಿದ ನಾಮ","ಪ್ರಸನ್ನ ನಾಗಿ ಸಂತತ ಇವನಿಗೆ ತನ್ನ","ಸಹಬೋಗ ಸುಖವನ್ನಿತ್ತ ನಾಮ||೧೦||"]],"transliteration":[["Rama Rama jaya Rama rama jaya seetaram","Rama Rama jaya Rama rama jaya seetaram"],["Anudina neneyalu hanumage ati priya paramapavana Rama nama ||"],["Inakula bhushanana munijana toshana |","Janaki ramanana nama || 1 ||"],["Goutama satiya punitala Madi prakyata pondida divya nama","sheetalakirana bhushanana dhanusha muridu seeteya pondida nama || 2 ||"],["Janakana vachanava ulisuva nevadali","vanavasa madidanu rama","vanadali karadooshanamukha dhanujara manana maḍida divya nama || 3 ||"],["sharabhanga munige paramapadavanitta paramapavitra nama","varisalu Banda shurpanakhina nasika Kanna udisida nama || 4 ||"],["Bhumijeya mosadinda agalisida marichana konda nama","swamiya premade maḍida jatayuge abhayahastavanitta nama || 5 ||"],["Aa Maha hanumanta kamitadante Mahendra sutana konda nama","komalakamala suyuta tanayage samrajyavanitta nama || 6 ||"],["Hariparivaradi sharadhiyol setubandhanava maḍida nama","dhurula ravana rakkasranne kondu","dharanisuteya tanda nama || 7 ||"],["Sharanara pondida bhakuta vibhishanage karunava torida nama","karuniseete lakshmananinda koodi pushpakava nerida sadhu nama || 8 ||"],["Gurutara tapadali niratanagi tamma bharatana ulisida nama","doretana pondi sakalasujanarige paratara sukhavitta nama || 9 ||"],["Tanna bhakutarolu unnatanenisida Ghana marutigolida nama","prasannanagi santata ivanige tanna","sahabhoga sukhavanitta nama || 10 ||"]],"aligned":true,"video":"XdUZw7JqJ3I","videos":["XdUZw7JqJ3I"],"sou