[{"slug":"baaro-baaro-paanduranga","titleKn":"ಬಾರೋ ಬಾರೋ ಪಾಂಡುರಂಗ","titleEn":"Baaro baaro paanduranga","form":"song","composer":null,"ankita":null,"raga":null,"tala":null,"stanzas":[["ಬಾರೋ ಬಾರೋ ಪಾಂಡುರಂಗ ನೀನೇ ಗತಿ|","ತೋರೋ ತೋರೋ ನಿನ್ನ ಮುಖವ ರುಕ್ಮಿಣಿಪತಿ||"],["ಚಂದ್ರಭಾಗ ತೀರದಲ್ಲಿ ವಾಸವಾಗಿರುವಿ |","ಮಂದರ ಗಿರಿಧರ ಸಿಂಧು ಶಯನ ಅಂದವಾಗಿರುವಿ ||1||","ಶಂಖ ಚಕ್ರವನ್ನು ನೀನು ಎಲ್ಲಿ ಇಟ್ಟಿರುವಿ ?","ಟೊಂಕದ ಮೇಲೆ ಕೈಯನಿಟ್ಟು ಏಕೆ ನಿಂತಿರುವಿ ?||2||"],["ಭಕ್ತರನೆಲ್ಲ ಉದ್ಧರಿಸುವ ನೀನೆ ದೊರೆ |","ಭಕ್ತವತ್ಸಲ ನರಸಿಂಹವಿಠ್ಠಲ ಹರೆ||3||"]],"transliteration":[["Baaro baaro paanduranga neene gati |","Toro toro ninna mogava rukmini pati || pa ||"],["Chandrabhaagaa teeradalli vaasavaagiruvi |","Mandaragiridhara sindhushayana andavaagiruvi ||1 ||"],["Shankha chakra gadhaa padma elli ittiruvi |","Tonkada mele kaiyanittu Eke nintiruvi || 2 ||"],["Bhaktarannella uddharisuve neene dore |","Bhaktavatsala naarasimha vithala hare || 3 ||"]],"aligned":false,"video":"HPVqaUoZM0A","videos":["HPVqaUoZM0A"],"sourceUrl":"https://bhakthilahari.com/2021/05/19/%e0%b2%ac%e0%b2%be%e0%b2%b0%e0%b3%8b-%e0%b2%ac%e0%b2%be%e0%b2%b0%e0%b3%8b-%e0%b2%aa%e0%b2%be%e0%b2%82%e0%b2%a1%e0%b3%81%e0%b2%b0%e0%b2%82%e0%b2%97-baaro-baaro-paanduranga/"},{"slug":"bandya-vittala-vrundavanadalli","titleKn":"ಬಂದ್ಯಾ ವಿಠ್ಠಲ ಬಡವನಲ್ಲಿ ವ್ರಂದಾವನದಲ್ಲಿ","titleEn":"Bandya vittala vrundavanadalli","form":"pada","composer":"vijaya-dasa","ankita":"ವಿಜಯ ವಿಠಲ","raga":null,"tala":null,"stanzas":[["ಬಂದ್ಯಾ ವಿಠ್ಠಲ ಬಡವನಲ್ಲಿ||2||","ವ್ರಂದಾವನದಲ್ಲಿ ಗೋವ್ರಂದಗಳ ಕಾಯ್ದವನೆ || ಬಂದ್ಯಾ||"],["ಕೊರಳಲಿ ಸರಿಗೆ ಸರಪಳಿ, ಪಚ್ಚೆ ಪದಕವು","ಪರಿಪರಿಯ ಹಾರ ಶ್ರೀ ತುಳಸಿಮಾಲೆ || ಕೊರಳಲಿ ||","ಸಿರಿಗಂಧ ಲೇಪ ಶ್ರೀವತ್ಸವುರ ಕಿರಿಡೊಳ್ಳು ||2||","ವರಕಟಿಗೆ ಘಂಟೆ ಪರಿಪರಿಯಧಾಮವ ಸುತ್ತಿ ||ಬಂದ್ಯಾ||"],["ಸುಳಿಗುರುಳು ಮೇಲೆ ,ಅರಳೆಲೆಯು ಕಿರೀಟ","ಎಲೆತಳಿರು ಚೂತ ,ಮಳ್ಳಿಗೆಯು ,ಧೂರ್ವೆ ||ಸುಳಿಗುರುಳು||","ತಳತಲಿಪ ಮುಖನಾಸ ನಯನ ಹಣೆಯಲಿ ತಿಲಕ ||ತಳತಲಿಪ||","ಚಲಿಸುವ ಕರ್ಣಕುಂಡಲ ಪ್ರಭೆಯು ಶೋಭಿಸುತ ||ಬಂದ್ಯಾ||"],["ಮುಂಗೈ ಕಡಗ ಸರಪಳಿ ತೋಳ ಬಾಪುರಿ","ಶ್ರಂಗಾರವಾದ ಗದೆ ,ಶಂಖ ,ಚಕ್ರ ||ಮುಂಗೈ||","ಅಂಗೈಯ ಪದುಮ,ಅಂಗುಲಿ ವೇಣು ಮೀಟುತ ||ಅಂಗೈಯ||","ಹಿಂಗದೆ ಎನ್ನ ಅಂತರಂಗದ ಮನೆಗಿನ್ನು ||ಬಂದ್ಯಾ||"],["ಈಸುಬಗೆಯ ಪೂಜೆಯು ಎನ್ನಿಂದಲಾಗದು","ಲೇಶವಾದರು ಇಲ್ಲ ಎನಗೆ ಜ್ಞಾನ ||ಈಸುಬಗೆಯ||","ಶ್ರೀಶನೆ ನೀ ನಂತಲ್ಲಿ ಸಕಲವು ಉಂಟು ||ಶ್ರೀಶನೆ||","ಶ್ರೀ ಶ್ರೀನಿವಾಸ ಗೋಪಾಲವಿಜಯವಿಠ್ಠಲ ||ಬಂದ್ಯಾ||"]],"transliteration":[["Bandya vittala badavanalli || 2 ||","vrundavanadalli govrundagala kaydavane || bandya ||"],["Koralali sarige sarapali pacche padakavu","paripariya haara Shree tulasimale ||","sirigandha lepa shrivatsavura kiridollu |","varakatige ghanatege paripariyadhamava sutti || bandya ||"],["Suligurulu mele araleleyu kireeta","eletaliru choota, malligeyu dhurve","talatalipa mukhanasa nayana haneyali tilaka |","chalisuva karnakundala prabheyu shobhisuta || bandya ||"],["Mungai kadagola sarapali tola bapuri |","shrungaravada gade, shankha chakra ||","angaiya paduma anguli venu meetuta |","hingade Enna antarangada maneginnu || bandya ||"],["Eesu bageyinda poojeyo ennindalagadu |","leshavadaru illa enage jnana ||","shreeshane nee nintalli sakalavu untu |","Shree shrinivasa gopalavijaya vittala || bandya ||"]],"aligned":true,"video":"ZHa0TFjmF3c","videos":["ZHa0TFjmF3c"],"sourceUrl":"https://bhakthilahari.com/2025/06/21/%e0%b2%ac%e0%b2%82%e0%b2%a6%e0%b3%8d%e0%b2%af%e0%b2%be-%e0%b2%b5%e0%b2%bf%e0%b2%a0%e0%b3%8d%e0%b2%a0%e0%b2%b2-%e0%b2%ac%e0%b2%a1%e0%b2%b5%e0%b2%a8%e0%b2%b2%e0%b3%8d%e0%b2%b2%e0%b2%bf-%e0%b2%b5/"},{"slug":"dangurava-sari-hariya","titleKn":"ಡಂಗುರವ ಸಾರಿ ಹರಿಯ","titleEn":"Dangurava sari hariya","form":"pada","composer":"purandara-dasa","ankita":"ಪುರಂದರ ವಿಠಲ","raga":null,"tala":null,"stanzas":[["ಡಂಗುರವ ಸಾರಿರಯ್ಯ ಡಿಂಗರಿಗರೆಲ್ಲರು | ಭೂ","ಮಂಡಲಕ್ಕೆ ಪಾಂಡುರಂಗ ವಿಠ್ಠಲ ಪರದೈವವೆಂದು || ಪ ||"],["ಹರಿಯು ಮುಡಿದ ಹೂವು ಹರಿವಾಣದೊಳಗಿಟ್ಟುಕೊಂಡು |","ಹರುಷದಿಂದ ಹಾಡಿ ಪಾಡಿ ಕುಣಿದು ಚಪ್ಪಾಳಿಕ್ಕುತ || ೧ ||"],["ಒಡಲು ಜಾಗಟೆಯ ಮಾಡಿ ನುಡಿವ ನಾಲಿಗೆಯ ಪಿಡಿದು |","ಬಿಡದೆ ಢಣಾರ್ ಢಣಾರೆಂದು ಹೊಡೆದು ಚಪ್ಪಾಳಿಕ್ಕುತ || ೨ ||"],["ಇಂತು ಲೋಕಕ್ಕೆಲ್ಲ ಲಕ್ಷ್ಮೀಕಾಂತನಲ್ಲದಿಲ್ಲವೆಂದು |","ಸಂತತ ಶ್ರೀಪುರಂದರ ವಿಠ್ಠಲ ಪರದೈವವೆಂದು || ೩ ||"]],"transliteration":[["Dangurava sari hariya dingarigellaru bhu-mandalakke panduranga vittalane paradaivavendu ||"],["Odala jagadeya madi nudiva naligeya pididu bidade thana thanarendu badidu chappalikkutta ||"],["Hariyu madida huva hari vanadalli hottu kondu harushadindali hadi padi kunidu chappalikkutta ||"],["Dangurava sari hariya dingarigellaru bhu-mandalakke panduranga vittalane paradaivavendu ||"],["Odala jagadeya madi nudiva naligeya pididu bidade thana thanarendu badidu chappalikkutta ||"],["Hariyu madida huva hari vanadalli hottu kondu harushadindali hadi padi kunidu chappalikkutta ||"],["Intu sakala jagake lakshmikantanalladillavendu santatam bhajisuta nishchinta purandara vittalanendu ||"]],"aligned":false,"video":"jMNKxL_znLM","videos":["jMNKxL_znLM"],"sourceUrl":"https://bhakthilahari.com/2021/02/04/%e0%b2%a1%e0%b2%82%e0%b2%97%e0%b3%81%e0%b2%b0%e0%b2%b5-%e0%b2%b8%e0%b2%be%e0%b2%b0%e0%b2%bf-%e0%b2%b9%e0%b2%b0%e0%b2%bf%e0%b2%af-dangurava-sari-hariya/"},{"slug":"elli-mareyade-vittalaa","titleKn":"ಎಲ್ಲಿ ಮರೆಯಾದೆ ವಿಠ್ಠಲಾ","titleEn":"Elli Mareyade Vittalaa","form":"pada","composer":"sripadaraja","ankita":"ರಂಗವಿಠಲ","raga":null,"tala":null,"stanzas":[["ರಂಗಾ…..ವಿಠ್ಠಲಾ….","ರಂಗಾ….ಪಾಂಡುರಂಗ ಎಲ್ಲಿ ಮರೆಯಾದೇ….","ಪಾಂಡುರಂಗಾ…ಆ…ಏಕೆ ದೂರಾದೆ"],["ಎಲ್ಲಿ ಮರೆಯಾದೆ ವಿಠ್ಠಲಾ, ಏಕೆ ದೂರಾದೆ","ರಂಗ ಏಕೆ ದೂರಾದೆ ಎಲ್ಲಿ ಮರೆಯಾದೆ. …"],["ದೇವರ ದೇವ ಎಂಬುದ ಮರೆತೆ ಸೇವಕನಂತೆ ನನ್ನೆಡೆ ನಿಂತೆ ||2||","ಮಾಧವ ನಿನ್ನ ಮಾಯಾಜಾಲ ||2||","ಮಾನವ ನಾನು ತಿಳಿಯಲಿಲ್ಲ ವಿಠ್ಠಲಾ….ರಂಗಾ…","||ಎಲ್ಲಿ ಮರೆಯಾದೆ||"],["ಸಾಧಿಸಿ ಹರಿಯ ಪ್ರೀತಿಯ ಒಲವು ಪೂಜಿಸಿದಂತ ಪೂಜ್ಯರು ನೀವು ||2||","ಬಲ್ಲಿರಿ ಅವನ ಅಂತರಂಗ ||2||","ಎಲ್ಲಿಹ ಹೇಳಿ ಪಾಂಡುರಂಗ ವಿಠ್ಠಲಾ. …ರಂಗಾ…","||ಎಲ್ಲಿ ಮರೆಯಾದೆ||"],["ಎತ್ತೆತ್ತಲೀಗ ಕಗ್ಗತ್ತಲಾಯಿತು ಗೊತ್ತಾಗದಾಯಿತೆ ವಿಠ್ಠಲಾ","ವಿಠ್ಠಲ ವಿಠ್ಠಲ ಜೈ ಜೈ ವಿಠ್ಠಲ","ವಿಠ್ಠಲ ವಿಠ್ಠಲ ಜೈ ಜೈ ವಿಠ್ಠಲ","ವಿಠ್ಠಲ ವಿಠ್ಠಲ ಜೈ ಜೈ ವಿಠ್ಠಲ"],["ಮುತ್ತಂತ ನಿನ್ನ ಕೈ ತುತ್ತ ತಿನ್ನೊ ಹೊತ್ತಾಯಿತು ಬಾರೊ ವಿಠ್ಠಲ","ವಿಠ್ಠಲ ವಿಠ್ಠಲ ಜೈ ಜೈ ವಿಠ್ಠಲ","ವಿಠ್ಠಲ ವಿಠ್ಠಲ ಜೈ ಜೈ ವಿಠ್ಠಲ","ವಿಠ್ಠಲ ವಿಠ್ಠಲ ಜೈ ಜೈ ವಿಠ್ಠಲ"],["ಬತ್ತಿರೊ ಬದುಕ , ಎತ್ತಿಸಿ ನಿ ಬೆಳಕ ,ಹತ್ತಿಸಿ ನೀ ಕಾಯೊ ವಿಠ್ಠಲಾ","ವಿಠ್ಠಲ ವಿಠ್ಠಲ ಜೈ ಜೈ ವಿಠ್ಠಲ","ವಿಠ್ಠಲ ವಿಠ್ಠಲ ಜೈ ಜೈ ವಿಠ್ಠಲ","ವಿಠ್ಠಲ ವಿಠ್ಠಲ ಜೈ ಜೈ ವಿಠ್ಠಲ"],["ಹೆತ್ತವಳಂತೆ ನೀನೆತ್ತಿಕೊಂಡು, ನನ್ನತ್ತ ನೋಡೊ ವಿಠ್ಠಲಾ. ..","ವಿಠ್ಠಲ ವಿಠ್ಠಲ ಜೈ ಜೈ ವಿಠ್ಠಲ","ವಿಠ್ಠಲ ವಿಠ್ಠಲ ಜೈ ಜೈ ವಿಠ್ಠಲ","ವಿಠ್ಠಲ ವಿಠ್ಠಲ ಜೈ ಜೈ ವಿಠ್ಠಲ"],["ನೀ ಎನ್ನ ಧನ, ನೀ ಎನ್ನ ಮನ , ನೀ ಪ್ರಾಣ ವಿಠ್ಠಲ","ಎನ್ನಾತ್ಮ ನಿಧಿಯೇ ಮುಖ ತೋರೊ ದೊರೆಯೆ||2||","ವಿಠ್ಠಲ ವಿಠ್ಠಲ ಜೈ ಜೈ ವಿಠ್ಠಲ","ವಿಠ್ಠಲ ವಿಠ್ಠಲ ಜೈ ಜೈ ವಿಠ್ಠಲ","ವಿಠ್ಠಲ ವಿಠ್ಠಲ ಜೈ ಜೈ ವಿಠ್ಠಲ","ವಿಠ್ಠಲ ವಿಠ್ಠಲ ಜೈ ಜೈ ವಿಠ್ಠಲ","ವಿಠ್ಠಲ ವಿಠ್ಠಲ ಜೈ ಜೈ ವಿಠ್ಠಲ","ವಿಠ್ಠಲ ವಿಠ್ಠಲ ಜೈ ಜೈ ವಿಠ್ಠಲ","ವಿಠ್ಠಲ ವಿಠ್ಠಲ ಜೈ ಜೈ ವಿಠ್ಠಲ","ವಿಠ್ಠಲ ವಿಠ್ಠಲ ಜೈ ಜೈ ವಿಠ್ಠಲ","ವಿಠ್ಠಲ ವಿಠ್ಠಲ ಜೈ ಜೈ ವಿಠ್ಠಲ……….."],["ರಂಗಾ….ವಿಠ್ಠಲಾ. …..ರಂಗಾ…."]],"transliteration":[["Ranga.. Vittalaa.. Ranga..","Paanduranga..","Elli Mareyade Paanduranga..a..","Eke Dooraade"],["Elli Mareyade Vittalaa","Yeke Dooraade","Ranga Yeke Dooraade","Elli Mareyade ||"],["Devara deva embuda marethe","sevakananthe nannede ninthe ||2||","Maadhava ninna maayaajaala ||2||","Maanava naanu thiliyalilla","Vittalaa.. Ranga.. ||Elli Mareyade||"],["Saadisi hariya preethiya ilavu","poojisidantha poojyaru neevu||2||","Balliri avana antharanga ||2||","Elliha heli paanduranga","Vittala.. Ranga.. ||Elli Mareyade||"],["Ettettaleega kaggatthalaaytu gottaagadaayte vittalaa","Vittalaa Vittalaajai Jai Vittalaa"],["Muttantha ninnakaitutta thinno","hotaaytu baaro vittalaa","Vittalaa Vittalaajai Jai Vittalaa"],["Battiro badukaetti nee belaka","hattisi kaayo vittalaa","Vittalaa Vittalaa Jai Jai Vittalaa"],["Hettavalante neenettikondu","nannattanodo vittalaa","Vittalaa Vittalaajai Jai Vittalaa"],["Nee enna dhana nee enna mana nee praana vittalaa","ennatma nidhiye mukha thoro doreye","ennatma nidhiye mukha thoro doreye","Vittalaa Vittalaajai Jai Vittalaa |3|","Vittalaa Vittalaajai Jai Vittalaa |3|","Vittalaa Vittalaajai Jai Vittalaa…"],["Ranga.. Vittala.. Ranga..","Vittalaa Vittalaajai Jai Vittalaa.."]],"aligned":true,"video":"qJo3ecB_abY","videos":["qJo3ecB_abY"],"sourceUrl":"https://bhakthilahari.com/2021/06/22/%e0%b2%8e%e0%b2%b2%e0%b3%8d%e0%b2%b2%e0%b2%bf-%e0%b2%ae%e0%b2%b0%e0%b3%86%e0%b2%af%e0%b2%be%e0%b2%a6%e0%b3%86-%e0%b2%b5%e0%b2%bf%e0%b2%a0%e0%b3%8d%e0%b2%a0%e0%b2%b2%e0%b2%be-elli-mareyade-vittalaa/"},{"slug":"enidu-koutuka-pandariyane-bittu","titleKn":"ಏನಿದು ಕೌತುಕ ಪಂಡರಿಯನೇ ಬಿಟ್ಟು","titleEn":"Enidu koutuka pandariyane bittu","form":"song","composer":null,"ankita":null,"raga":null,"tala":null,"stanzas":[["ಏನಿದು ಕೌತುಕ ಪಂಡರಿಯನೇ ಬಿಟ್ಟು ||","ನೀನಿಲ್ಲಿಗೆ ಬಂದ್ಯಾ ವಿಠ್ಠಲಾ || ಪ ||"],["ಮಿಥ್ಯವಾದಿಗಳು ನಿನ್ನನು || ಸುತ್ತುಮುತ್ತಿಕೊಂಡಿಹರು ||","ಅತ್ತು ಕರೆದು ಕೂಗುತ್ತಿರೆ ಬಹು ||","ಬ್ಯಾಸತ್ತು ಬಂದೆಯಾ ವಿಠ್ಠಲ ||೧||"],["ಮಧ್ವದ್ವೇಷಿಗಳು ಮಾಡುವ| ಪದ್ಧತಿಯನು ಕಂಡು ||","ಹೃದ್ಯವಾಗದೆ ಕದ್ದ ಕಳ್ಳನಂತೆದ್ದು ||","ಎದ್ದು ಓಡಿ ಬಂದಿಯಾ ವಿಠ್ಠಲಾ || ೨ ||","ಶ್ರೀರಾ ವಿಠ್ಠಲಾ ನಿಮ್ಮ ಸುಗುಣವೇದ ಶಾಸ್ತ್ರದಲ್ಲಿ","ಶೋಧಿಸಿ ನೋಡಲು ಭೂ ದೇವರಿಗೊಲಿದು","ಆದರಿಸ ಬಂದೆಯಾ ವಿಠ್ಠಲ ವಿಠಲ||೩||"]],"transliteration":[["Enidu koutuka pandariyane bittu |","neenillige vandya vittala || pa ||"],["Mithyavadigalu ninnane | suttumuttikondiharu ||","attu karedu kooguttire bahu |","byasattu bandeya vittala || 1 ||"],["Madhwadweshigalu maduva | paddhatiyanu kandu ||","hrudyavagade kadda kallananteddu","eddu odi bandiya vittala || 2 ||"],["Shreeraa vittala nimma sugunaveda shastradalli","shodhisi nodale Bhu- devarigolidu","adarisa bandeya vittala vitala || 3 ||"]],"aligned":false,"video":null,"videos":[],"sourceUrl":"https://bhakthilahari.com/2025/04/23/%e0%b2%8f%e0%b2%a8%e0%b2%bf%e0%b2%a6%e0%b3%81-%e0%b2%95%e0%b3%8c%e0%b2%a4%e0%b3%81%e0%b2%95-%e0%b2%aa%e0%b2%82%e0%b2%a1%e0%b2%b0%e0%b2%bf%e0%b2%af%e0%b2%a8%e0%b3%87-%e0%b2%ac%e0%b2%bf%e0%b2%9f/"},{"slug":"iduve-pandarapura-vittala-iduve","titleKn":"ಇದುವೇ ಪಂಡರಾಪುರ ವಿಠ್ಠಲ ಇದುವೇ","titleEn":"Iduve pandarapura vittala iduve","form":"song","composer":null,"ankita":null,"raga":null,"tala":null,"stanzas":[["ಇದುವೇ ಪಂಡರಾಪುರ |","ವಿಠ್ಠಲ ಇದುವೇ ಪಂಡರಾಪುರ||","ಇದ ನಾ ಅರಿಯದೆ ಪೊದೆ ಮುಕುತಿಯ ಧಾಮ ||"],["ಪಾಪವ ತೊಳೆವ ಪಾವನ ಚಂದ್ರಭಾಗ | ತಾಪವ ಹರಿಸಿ ಶಾಂತಿಯ ನೀವ |","ಈ ವರ ಕ್ಷೇತ್ರ ಭೂವೈಕುಂಠ | ಭವ ಭಯ ಪರಿಹಾರ ವಿಠಲ||"],["ಪುಣ್ಯದ ದಿವಸ ಏಕಾದಶಿಯಿಂದು | ಹಾಡುತ ನಲಿಯುತ ಭಕುತರು ಬಂದು||","ನೋಡುವ ಭಾಗ್ಯ ಎನಗೆ ಇಂದು| ಕರುಣಿಸಿ ವರಗೈವೇ ವಿಠಲ ||"],["ಸಂತಾಳಜನಿಯು ಯೋಗಮಿಳನು| ಶ್ರೀ ತುಕರಾಮನು ಜ್ಞಾನೇಶ್ವರನು ||","ಪುಂಡಲೀಕನು ವಾಮದೇವನು | ಮೋಕ್ಷವನೆ ಪಡೆದ ವಿಠಲ ||"]],"transliteration":[["Iduve Pandharapura"],["Iduvē Paṇḍharāpura | Viṭhṭhala iduvē Paṇḍharāpura ||","Ida nā ariyade hōde mukutiya dhāma ||"],["Pāpava toḷeva pāvana Chandrabhāga | Tāpava harisi śhāntiya nīva |","Ī vara kṣhētra bhūvaikuṇṭha | Bhava bhaya parihāra Viṭhala ||"],["Puṇyada divasa ēkādaśhiyindu | Hāḍuta naliyuta bhakutaru bandu ||","Nōḍuva bhāgya enage indu | Karuṇisi varagaivē Viṭhala ||"],["Santāḷajaniyu Yōgamiḷanu | Śrī Tukarāmanu Jñānēśvaranu ||","Puṇḍalīkanu Vāmadēvanu | Mōkṣhavane paḍeda Viṭhala ||"]],"aligned":false,"video":"EVewJOw3szs","videos":["EVewJOw3szs"],"sourceUrl":"https://bhakthilahari.com/2025/07/02/%e0%b2%87%e0%b2%a6%e0%b3%81%e0%b2%b5%e0%b3%87-%e0%b2%aa%e0%b2%82%e0%b2%a1%e0%b2%b0%e0%b2%be%e0%b2%aa%e0%b3%81%e0%b2%b0-%e0%b2%b5%e0%b2%bf%e0%b2%a0%e0%b3%8d%e0%b2%a0%e0%b2%b2-%e0%b2%87%e0%b2%a6/"},{"slug":"ittige-mele-ninta-namma","titleKn":"ಇಟ್ಟಿಗೆ ಮೇಲೆ ನಿಂತ ನಮ್ಮ","titleEn":"Ittige mele ninta namma","form":"pada","composer":"purandara-dasa","ankita":"ಪುರಂದರ ವಿಠಲ","raga":null,"tala":null,"stanzas":[["ಇಟ್ಟಿಗೆ ಮೇಲೆ ನಿಂತ ನಮ್ಮ ಇಟ್ಟಿಗೆ ಮೇಲೆ ನಿಂತ ನಮ್ಮ ವಿಠ್ಠಲ ತಾನು","ಪುಟ್ಟಪಾದ ಊರಿನಿಂತ ದಿಟ್ಟ ತಾನು ||ಪ||"],["ಪುಟ್ಟ ಪಾದ ಊರಿ ನಿಂತ ಗಟ್ಟಿಯಾಗಿ ನಿಂತಾನಮ್ಮ","ಟೊಂಕದ ಮೇಲೆ ಕೈಯಕಟ್ಟಿ ಭಕ್ತರು ಬರುವುದ ನೋಡುವನಮ್ಮ ||ಅ ಪ||"],["ಪಂಢರಪುರದಲ್ಲಿರುವನಂತೆ ಪಾಂಡುರಂಗ ಎಂಬುವನಂತೆ| ಚಂದ್ರಭಾಗ ಪಿತ ಇವನಂತೇ","ಚಂದ್ರಭಾಗ ಪತಿ ಇವನಂತೇ ಅರಸಿರುಕ್ಮಿಣಿ ಪತಿ ಇವನಂತೇ ||೧||"],["ಕನಕದಾಸೆ ಇವಗಿಲ್ಲವಮ್ಮ ಹಣದ ಆಸೆ ಬೇಕಿಲ್ಲವಮ್ಮ|| ನಾದಬ್ರಹ್ಮ ಎಂಬುವ ನಮ್ಮ","ನಾದಬ್ರಹ್ಮ ಎಂಬುವ ನಮ್ಮ ಭಕುತರ ವಚನಕೆ ಕಾದಿಹನಮ್ಮ ||೨||"],["ಕರಿಯಕಂಬಳಿ ಹೊದ್ದಿಹನಮ್ಮ ಹಣೆಗೆ ನಾಮ ಹಚ್ಚಿಹನಮ್ಮ||","ತುಳಸಿಮಾಲೆ ಹಾಕ್ಯನಮ್ಮ ಪುರಂದರವಿಠ್ಠಲನೊಲಿದನಮ್ಮ ||೩||"]],"transliteration":[["Ittige mele ninta namma vittala tanu","Putta pada oori ninta ditta tanu"],["Putta paada oori ninta gattiyaagu nintaanamma | tonkada mele kaiya katti bhaktaru baruvuda noduvanamma ||"],["Pandara puradali iruvanante panduranga embuvanante","Chandra baga pita ivanante angane rukmini arasanante||1||"],["Kanakadase ivagillante hanada Ase bekillante","Nadabrahma embuvanamma bhakutara karege kaadihanante||2||"],["Kariya kambali hoddiyanante haneyali nama hacchihanante","Tulasimale hakyanante purandara vittalanolidanamma||3||"]],"aligned":true,"video":"mC33EW83a1E","videos":["mC33EW83a1E"],"sourceUrl":"https://bhakthilahari.com/2020/11/08/%e0%b2%87%e0%b2%9f%e0%b3%8d%e0%b2%9f%e0%b2%bf%e0%b2%97%e0%b3%86-%e0%b2%ae%e0%b3%87%e0%b2%b2%e0%b3%86-%e0%b2%a8%e0%b2%bf%e0%b2%82%e0%b2%a4-%e0%b2%a8%e0%b2%ae%e0%b3%8d%e0%b2%ae-ittige-mele-ninta-namma/"},{"slug":"jay-jay-vittala-panduranga","titleKn":"ಜಯ ಜಯ ವಿಠಲ ಪಾಂಡುರಂಗ","titleEn":"Jay Jay vittala panduranga","form":"song","composer":null,"ankita":null,"raga":null,"tala":null,"stanzas":[["ಜೈ ಜೈ ವಿಠ್ಠಲ ಪಾಂಡುರಂಗ","ಜೈ ಹರಿ ವಿಠ್ಠಲ ಪಾಂಡುರಂಗ ||2 times||"],["ಆಪತ್ಬಾಂಧವ ಪಾಂಡುರಂಗ ಅನಾಥ ರಕ್ಷಕ ಪಾಂಡುರಂಗ ||2 times ||","ಜೈ ಜೈ ವಿಠ್ಠಲ ಪಾಂಡುರಂಗ ಜೈ ಹರಿ ವಿಠ್ಠಲ ಪಾಂಡುರಂಗ ||2 times||"],["ಭಕ್ತ ಪೋಷಕ ಪಾಂಡುರಂಗ ಮುಕ್ತಿ ಪ್ರದಾಯಕ ಪಾಂಡುರಂಗ ||2 times||","ಜೈ ಜೈ ವಿಠ್ಠಲ ಪಾಂಡುರಂಗ ಜೈ ಹರಿ ವಿಠ್ಠಲ ಪಾಂಡುರಂಗ ||2 times||"],["ತಂದೆ ವಿಠ್ಠಲ ಪಾಂಡುರಂಗ ತಾಯಿ ವಿಠ್ಠಲ ಪಾಂಡುರಂಗ || 2 times ||","ಜೈ ಜೈ ವಿಠ್ಠಲ ಪಾಂಡುರಂಗ ಜೈ ಹರಿ ವಿಠ್ಠಲ ಪಾಂಡುರಂಗ ||2 times||"]],"transliteration":[["Jai Jai Vittala Panduranga","Jai Hari Vittala Panduranga","Jai Jai Vittala Panduranga","Jai Hari Vittala Panduranga"],["Apath Bandhava Panduranga","Anatha Rakshaka Panduranga","Apath Bandhava Panduranga","Anatha Rakshaka Panduranga","Jai Jai Vittala Panduranga","Jai Hari Vittala Panduranga","Jai Jai Vittala Panduranga","Jai Hari Vittala Panduranga"],["Bhakta Poshaka Panduranga","Mukthi Pradayaka Panduranga","Bhakta Poshaka Panduranga","Mukthi Pradayaka Panduranga","Jai Jai Vittala Panduranga","Jai Hari Vittala Panduranga","Jai Jai Vittala Panduranga","Jai Hari Vittala Panduranga"],["Tande Vittala Panduranga","Thayi Vittala Panduranga","Tande Vittala Panduranga","Thayi Vittala Panduranga","Jai Jai Vittala Panduranga","Jai Hari Vittala Panduranga","Jai Jai Vittala Panduranga","Jai Hari Vittala Panduranga"]],"aligned":true,"video":"_UXsZ7GHkYk","videos":["_UXsZ7GHkYk"],"sourceUrl":"https://bhakthilahari.com/2020/05/22/%e0%b2%9c%e0%b2%af-%e0%b2%9c%e0%b2%af-%e0%b2%b5%e0%b2%bf%e0%b2%a0%e0%b2%b2-%e0%b2%aa%e0%b2%be%e0%b2%82%e0%b2%a1%e0%b3%81%e0%b2%b0%e0%b2%82%e0%b2%97-jay-jay-vittala-panduranga/"},{"slug":"jayatu-jaya-vittala","titleKn":"ಜಯತು ಜಯ ವಿಠ್ಠಲ","titleEn":"Jayatu jaya vittala","form":"song","composer":null,"ankita":null,"raga":null,"tala":null,"stanzas":[["ಜಯತು ಜಯ ವಿಠಲ","ನಿನ್ನ ನಾಮವು ಶಾಂತಿ ಧಾಮವು ಸೌಖ್ಯದಾರಾಮ|| ಪ ||"],["ಪಾವನಾಂಗ ಪಂಡರೀನಾಥ","ಪಾದಸೇವಾ ಪುಣ್ಯವಿನೀತ","ಕರುಣಿಸಿ ಬಾರಯ್ಯ","ದರುಶನ ತಾರಯ್ಯ","ನೀ ಎನ್ನ ಭಾಗ್ಯವಯ್ಯ","ಪಾಂಡುರಂಗ, ಪಾಂಡುರಂಗಯ್ಯ || 1 ||"],["ಕನಸು ಮನಸಿನ ಜೀವವು ನೀನೆ","ಅಂತರಾತ್ಮನ ಭಾವವು ನೀನೆ","ಅನ್ಯವು ಇಲ್ಲಯ್ಯ","ಎಲ್ಲವು ನೀನಯ್ಯ","ತುಕಾ ಎಂದ ಮಾತಿದಯ್ಯ","ಪಾಂಡುರಂಗ ಪಾಂಡುರಂಗಯ್ಯ || 2 ||"]],"transliteration":[["Jayatu jaya vittala | ninna naamavu shanti dhamavu sowkyada raama ||"],["Paavanaanga pandarinaatha paadaseva punyavineetha | karunisi baarayya darushana taarayya | nee enna bhagyavayya paamduranga, paandurangayya ||1||"],["Kanasu manasina jeevavu neene antaraatmana bhaavavu neene anyavu ellayya , ellavu neenayya tukaa enda maatidayya panduranga, paandurangayya ||2||"],["Youtube link : https://youtu.be/a68fkWQbTR8 by Sri P.B.Srininvas"]],"aligned":false,"video":null,"videos":[],"sourceUrl":"https://bhakthilahari.com/2020/08/22/%e0%b2%9c%e0%b2%af%e0%b2%a4%e0%b3%81-%e0%b2%9c%e0%b2%af-%e0%b2%b5%e0%b2%bf%e0%b2%a0%e0%b3%8d%e0%b2%a0%e0%b2%b2-jayatu-jaya-vittala/"},{"slug":"maanava-dehavu-moole-mamsada","titleKn":"ಮಾನವ ದೇಹವು ,ಮೂಳೆ","titleEn":"Maanava dehavu, moole mamsada","form":"pada","composer":"sripadaraja","ankita":"ರಂಗವಿಠಲ","raga":null,"tala":null,"stanzas":[["ಪರತತ್ವವನು ಬಲ್ಲ ಪಂಡಿತನು ನಾನಲ್ಲ","ಹರಿನಾಮವೊಂದುಳಿದು","ನನಗೇನುತಿಳಿದಿಲ್ಲ ,ನನಗೇನು ತಿಳಿದಿಲ್ಲ"],["ಮಾನವ…ದೇಹವು ,ಮೂಳೆ ಮಾಂಸದ ತಡಿಕೆ","ಮಾನವ ಮೂಳೆ ಮಾಂಸದ ತಡಿಕೆ","ಇದರ ಮೇಲಿದೆ ತೊಗಲಿನ ಹೊದಿಕೆ","ತುಂಬಿದೆ ಒಳಗೆ ಕಾಮಾದಿ ಬಯಕೆ","||ಮಾನವ||"],["ನವ ಮಾಸಗಳೂ ಹೊಲಸಲಿ ಕಳೆದು ಆ……","ನವ ರಂಧ್ರಗಳಾ ಕಳೆದು ಬೆಳೆದು","ಬಂದಿದೆ ಭುವಿಗೆ ಈ ನರ ಗೊಂಬೆ","ನಂಬಲು ಏನಿದೆ ಸೌಭಾಗ್ಯವೆಂದೇ"],["ಮಾನವಾ ಮೂಳೆ ಮಾಂಸದ ತಡಿಕೆ","ದೇಹವು ಮೂಳೆ ಮಾಂಸದ ತಡಿಕೆ"],["ಉಸಿರಾಡುವ ತನಕ ನಾನು","ನನದೆಂಬ ಮಮಕಾರ","ನಿಂತ ಮರು ಘಳಿಗೆ ಮಸಣದೆ ಸಂಸ್ಕಾರ","ಮಣ್ಣಲಿ ಬೆರೆತು ಮೆಲ್ಲಗೆ ಕೊಳೆತು","ಮುಗಿಯುವ ದೇಹಕೆ ವ್ಯಾಮೋಹವೇಕೆ"],["ಮಾನವಾ ಮೂಳೆ ಮಾಂಸದ ತಡಿಕೆ","ದೇಹವು ಮೂಳೆ ಮಾಂಸದ ತಡಿಕೆ"],["ಬರುವಾಗ ಬೆತ್ತಲೆ ಹೋಗುವಾಗ ಬೆತ್ತಲೆ","ಬಂದು ಹೋಗುವ ನಡುವೆ ಬರೀ ಕತ್ತಲೆ","ಭಕ್ತಿಯ ಬೆಳಕು ಬಾಳಿಗೆ ಬೇಕು","ಮುಕ್ತಿಗೆ ವಿಠಲನ ಕೊಂಡಾಡಬೇಕು","||ಮಾನವ||"],["ವಿಠ್ಠಲಾ….ವಿಠ್ಠಲ…ಪಾಂಡುರಂಗ ವಿಠ್ಠಲ||6||"]],"transliteration":[["Paratatvavanu balla panditanu naanalla | harinaamavondulidu nanagenu tilidilla ||"],["Maanava … dehavu, moole maamsada tadike | maanava moole maamsada tadike edara melide togalina hodike, tumbide olage kaamaadi bayake ||maanava||"],["Nava maasagalu holasali kaledu, nava randhragala kaledu beledu, bandide bhuvige e nara gombe, nambalu enide soubhagyavende ||maanava||"],["Usiraaduva tanaka naanu, nanademba mamakaara | ninta maru ghalige masanade samskaara | mannali beretu mellage koletu, mugiyuva dehake vyaamohaveke ||maanava||"],["Baruvaaga bettale hoguvaaga bettale | bandu hoguva naduve baree kattale | bhaktiya belaku baalige beku muktige vithalana kondaadabeku ||maanava||"],["vithalaa … vithala … panduranga vithala"]],"aligned":false,"video":"4v2vNFZg_uw","videos":["4v2vNFZg_uw"],"sourceUrl":"https://bhakthilahari.com/2021/07/15/%e0%b2%ae%e0%b2%be%e0%b2%a8%e0%b2%b5-%e0%b2%a6%e0%b3%87%e0%b2%b9%e0%b2%b5%e0%b3%81-%e0%b2%ae%e0%b3%82%e0%b2%b3%e0%b3%86-maanava-dehavu-moole-mamsada/"},{"slug":"naa-bheashtanadaru-nee-enna-kaibidadade","titleKn":"ನಾ ಭ್ರಷ್ಟನಾದರೂ ನೀ ಎನ್ನ ಕೈಬಿಡದಾದೆ","titleEn":"Naa bheashtanadaru nee Enna kaibidadade","form":"ugabhoga","composer":null,"ankita":null,"raga":null,"tala":null,"stanzas":[["ಉಗಾಭೋಗ"],["ನಾ ಭ್ರಷ್ಟನಾದರೂ ನೀ ಎನ್ನ ಕೈಬಿಡದಾದೆ","ನಾ ನಿನ್ನ ಮರೆತರೂ ನೀ ಎನಗೆ ಕರುಣಿಸಿದೆ","ನಾ ಅಲ್ಪನಾದರೂ ನೀ ಎನಗೆ ಅತಿಯಾಗಿ ಕೀರ್ತಿ ಮಾಡಿಸಿದೆ","ಅರಿಯಲು ಆಳವಲ್ಲ ನಿನ್ನ ಮಹಿಮೆ","ಜನುಮ ಜನುಮಕು ನಿನ್ನ ಸೇವೆ ಎನಗಿತ್ತು ಸಲಹೋ","ಜಗಕಾಧಾರ *ಜಯರಾಮವಿಠಲ*"]],"transliteration":[["Naa bheashtanadaru nee Enna kaibidadade","naa Ninna maretaru nee enage karuniside","naa alpanadaru nee enage atiyagi keerthiya madiside","ariyalu alavalla Ninna mahime","januma janumaku Ninna seve enagittu salaho","janakadhara jayaramavittala"]],"aligned":false,"video":null,"videos":[],"sourceUrl":"https://bhakthilahari.com/2025/05/08/%e0%b2%89%e0%b2%97%e0%b2%be%e0%b2%ad%e0%b3%8b%e0%b2%97-%e0%b2%a8%e0%b2%be-%e0%b2%ad%e0%b3%8d%e0%b2%b0%e0%b2%b7%e0%b3%8d%e0%b2%9f%e0%b2%a8%e0%b2%be%e0%b2%a6%e0%b2%b0%e0%b3%82-%e0%b2%a8%e0%b3%80/"},{"slug":"naa-donkaadarenu-ninna-naama","titleKn":"ನಾ ಡೊಂಕಾದರೇನು ನಿನ್ನ ನಾಮ","titleEn":"Naa donkaadarenu ninna naama","form":"pada","composer":"purandara-dasa","ankita":"ಪುರಂದರ ವಿಠಲ","raga":null,"tala":null,"stanzas":[["ನಾ ಡೊಂಕಾದರೇನು ನಿನ್ನ ನಾಮ ಡೊಂಕೆ ವಿಠಲ ||"],["ನದಿಯು ಡೊಂಕಾದರೇನು ಉದಕ ಡೊಂಕೆ ವಿಠಲ","ಕಬ್ಬು ಡೊಂಕಾದರೇನು ಸಿಹಿಯು ಡೊಂಕ ವಿಠಲ ||"],["ಪುಷ್ಪ ಡೊಂಕಾದರೇನು ಗಂಧ ಡೊಂಕೆ ವಿಠಲ","ಆಕಳು ಡೊಂಕಾದರೇನು ಹಾಲು ಡೊಂಕೆ ವಿಠಲ ||"],["ಬಿಲ್ಲು ಡೊಂಕಾದರೇನು ಬಾಣ ಡೊಂಕೆ ವಿಠಲ","ನಾನು ಹೊಲೆಯನಾದರೇನು ನಿನ್ನ ನಾಮ ಹೊಲೆಯೆ ವಿಠಲ ||"],["ಅಜ್ಯನಾದರೇನು ಕಾಯೋ ಸುಜ್ಯ ಪುರಂದರ ವಿಠಲ ||"]],"transliteration":[["Naa donkaadarenu ninna naama donke vittala ||"],["Nadiyu donkaadarenu udaka donke vittala | kabbu donkaadarenu sihiyu donke vittala ||"],["Pushpa donkaadarenu gandha donke vittala | aakalu donkaadarenu haalu donke vittala ||"],["Billu donkaadarenu baana donke vittala | naanu holeyanaadarenu ninna naama holeye vittala ||"],["Ajyanaadarenu kaayo sujya purandara vittala ||"]],"aligned":true,"video":"NyDI_NXpdv4","videos":["NyDI_NXpdv4"],"sourceUrl":"https://bhakthilahari.com/2022/07/08/%e0%b2%a8%e0%b2%be-%e0%b2%a1%e0%b3%8a%e0%b2%82%e0%b2%95%e0%b2%be%e0%b2%a6%e0%b2%b0%e0%b3%87%e0%b2%a8%e0%b3%81-%e0%b2%a8%e0%b2%bf%e0%b2%a8%e0%b3%8d%e0%b2%a8-%e0%b2%a8%e0%b2%be%e0%b2%ae-naa-donkaadare/"},{"slug":"nee-karuniso-vithala-namma","titleKn":"ನೀ ಕರುಣಿಸೋ ವಿಠಲ ನಮ್ಮ","titleEn":"Nee karuniso vithala namma","form":"song","composer":null,"ankita":null,"raga":null,"tala":null,"stanzas":[["ನೀ ಕರುಣಿಸೋ ವಿಠಲ ನಮ್ಮ ಸಾಕೊ ಪಂಡರಿ ವಿಠಲ || pa||"],["ವಿಠಲ ವಿಠಲ ಪಾಂಡುರಂಗ ಜೈ ಜೈ ವಿಠಲ ಪಾಂಡುರಂಗ|ದೋಷಿಗಳೊಳಗೆ ಹಿರಿಯನು ನಾ ನಿರ್ದೋಷಿಗಳರಸನೇ ವಿಠಲ | ಸಾಸಿವೆಯಷ್ಟು ಭಕುತಿಯನರಿಯೇನೋ ಶೇಷ ಶಯನ ಹರಿ ವಿಠಲ ||1||"],["ಭವಸಾಗರದೊಳು ಮುಳುಗುವೆ ಸುಮ್ಮನೆ ಅವಲೋಕಿಸುವರೇ ವಿಠಲ |ನವ ನವ ವಿಷಯಕೆ ಹಿಗ್ಗುತಲಿಹ ಮನದವಸರ ಕಾಯೋ ವಿಠಲ ||2||"],["ನಿಶಿದಿನ ಅಶನ ವಸನಕೆ ಹೆಣಗುವೆ ಹುಸಿ ಸಂಗ್ರಹಿಸಿದೆ ವಿಠಲ | ನಿಷೇಧ ಮಾಯಾ ಇಲ್ಲವೋ ನರಕದ ಗಸಣೆಗೆ ಅಂಜುವೆ ವಿಠಲ ||3||"],["ಜಾವಕೇ ಮಾಡುವೆ ಸಾವಿರ ತಪ್ಪನು ಕಾಯೋ ದಯಾಂಬುಧಿ ವಿಠಲ | ಶ್ರೀವರ ಪ್ರಸನ್ನ ವೆಂಕಟ ವಿಠಲ ಜೀವಕೆ ಹೊಣೆ ನೀ ವಿಠಲ ||4||"]],"transliteration":[["Nee karuniso vithala namma saako pandari vithala ||pa||"],["vithala vithala panduranga jai jai vithala panduranga ||"],["Doshigalolage hiriyanu naa nirdoshigalarasane vithala |","saasiveyashtu bhakutiyanariyeno shesha shayana hari vithala ||1||"],["Bhavasaagaradolu muluguve summane avalokisuvare vithala |nava nava vishayake higgutaliha manadavasara kaayo vithala ||2||"],["Nishidina ashana vasanake henaguve husi sangrahiside vithala | nishedha maayaa illavo narakada gasanege anjuve vithala ||3||"],["Jaavake maaduve saavira tappanu kaayo dayambudhi vithala | shreevara prasanna venkata vithala jeevake hone nee vithala ||4||"]],"aligned":false,"video":"6CpW30smCTA","videos":["6CpW30smCTA"],"sourceUrl":"https://bhakthilahari.com/2021/08/09/%e0%b2%a8%e0%b3%80-%e0%b2%95%e0%b2%b0%e0%b3%81%e0%b2%a3%e0%b2%bf%e0%b2%b8%e0%b3%8b-%e0%b2%b5%e0%b2%bf%e0%b2%a0%e0%b2%b2-%e0%b2%a8%e0%b2%ae%e0%b3%8d%e0%b2%ae-nee-karuniso-vithala-namma/"},{"slug":"nere-nambidhe-mad-hrudaya","titleKn":"ನೆರೆನಂಬಿದೆ ಮದ ಹೃದಯ","titleEn":"Nere Nambidhe mad hrudaya","form":"song","composer":null,"ankita":null,"raga":null,"tala":null,"stanzas":[["ನೆರೆನಂಬಿದೆ ಮದ ಹೃದಯ ಮಂಟಪದೊಳು","ಪರಿಶೋಭಿಸುತಿರು ಪಾಂಡುರಂಗ ||ಪ||"],["ಶರಣು ಜನರ ಸಂಸಾರ ಮಹಾ ಭಯ","ಹರಣ ಕರುಣ ಸಿರಿ ಪಾಂಡುರಂಗ ||ಅ.ಪ||"],["ನೆರೆದಿಹ ಬಹುಜನರೋಳಿದ್ದರು ಮನ","ಸ್ಥಿರ ವಿಡು ನಿನ್ನಲಿ ಪಾಂಡುರಂಗ","ಪರಿ ಪರಿ ಕೆಲಸವು ನಿನ್ನ ಮಹಾಪೂಜೆ","ನಿರುತ ಎನಗೆ ಕೊಡು ಪಾಂಡುರಂಗ ||೧||"],["ಪರದೇವನೆ ನಿನ್ನಾ ಲೀಲಾ ಸ್ಮೃತಿಯನು","ನಿರುತ ಎನಗೆ ಕೊಡು ಪಾಂಡುರಂಗ","ಪರರಾಪೇಕ್ಷೆಯ ಬಿಡಿಸಿ ನಿರಂತರ","ಪರಗತಿ ಪಥ ತೋರೋ ಪಾಂಡುರಂಗ ||೨||"],["ಸುಖವಾಗಲಿ ಬಹು ದುಃಖವಾಗಲಿ","ಸಖನೀನಾಗಿರು ಪಾಂಡುರಂಗ","ನಿಖಿಲಾಂತರ್ಗತ ವ್ಯಾಸ ವಿಠಲ ತವ","ಮುಖ ಪಂಕಜ ತೋರೋ ಪಾಂಡುರಂಗ ||೩||"]],"transliteration":[["Nere Nambidhe madh hrudhaya mantapadholu","parishobisuthiru Panduranga ||","sharana janara samsara mahabaya","charana karuna siri Panduranga ||"],["paradhevane ninna lilla stuthiyanu","nirutha enage kodu Panduranga","parara peksheya thoresi niranthara","paragathi patha thoro Panduranga || 1 ||"],["neredhiha bahu janarolidhdharu","manasthiravidu ninnali Panduranga","paripari kelasavu ninna mahapuje","nirutha enage kodu Panduranga || 2 ||"],["sukavagali bahu dhuhkavagali","saka ninagiru Panduranga","nikilanthargatha vyasa vitala thava","pankaja mukha thoro Panduranga || 3 ||"]],"aligned":false,"video":"_GonrLYYAcY","videos":["_GonrLYYAcY"],"sourceUrl":"https://bhakthilahari.com/2021/02/14/%e0%b2%a8%e0%b3%86%e0%b2%b0%e0%b3%86%e0%b2%a8%e0%b2%82%e0%b2%ac%e0%b2%bf%e0%b2%a6%e0%b3%86-%e0%b2%ae%e0%b2%a6-%e0%b2%b9%e0%b3%83%e0%b2%a6%e0%b2%af-nere-nambidhe-mad-hrudaya/"},{"slug":"o-panduranga-prabho","titleKn":"ಓ ಪಾಂಡುರಂಗ ಪ್ರಭೋ","titleEn":"O panduranga prabho","form":"song","composer":null,"ankita":null,"raga":null,"tala":null,"stanzas":[["ಓ ಪಾಂಡುರಂಗ ಪ್ರಭೋ ವಿಠ್ಠಲ ವೇಣುಗೋಪಾಲ ರುಕ್ಮಿಣೀಲೋಲ ||ಓ ಪಾಂಡುರಂಗ ಪ್ರಭೋ ವಿಠ್ಠಲ ||ವೇಣುಗೋಪಾಲ ರುಕ್ಮಿಣೀಲೋಲ||"],["ನಿನ್ನೀ ಪಾವನ ಪಾದಗಳ |ಮಹಿಮೆಯ ಬಣ್ಣಿಸೇ ಮಾತುಗಳ|ಕಾಣೆನು ತಂದೆ ವಿಠ್ಠಲಾ ||ಓ ಪಾಂಡುರಂಗ ||"],["ಆಕಾಶ ಭೂಮಿಗಳ ಅಳೆದಂತ ಪಾದ | ಕಾಳಿಂಗನಾಶಿರದಿ ಕುಣಿದಾಡಿದ ಪಾದ |ಕಾನನದಿ ಕಲ್ಲಾದ ಮುನಿಸತಿಗೆ ಜೀವವ ತಂದ | ಪಾವನ ಶ್ರೀ ಪಾದವ ನಂಬಿಹೆನಯ್ಯ ||ಓ ಪಾಂಡುರಂಗ ||"],["ಶ್ರೀ ದೇವಿ ಪೂಜಿಸುವ ಶ್ರೀಹರಿಯ ಪಾದ | ಭಕುತರಿಗೆ ಮುಕುತಿಯನು ಕೊಡುವಂತ ಪಾದ |ಪಾಪವನು ಕಳೆವಂತ, ಸುರಗಂಗೆ ಜನ್ಮಿಸಿದಂತ |","ರಂಗನ ಶ್ರೀ ಪಾದವ ನಂಬಿಹೆನಯ್ಯ ||ಓ ಪಾಂಡುರಂಗ ||ಓ ಪಾಂಡುರಂಗ ||"],["ಪ್ರಭೋ ವಿಠ್ಠಲ ಪ್ರಭೋ ವಿಠ್ಠಲ ಪ್ರಭೋ ವಿಠ್ಠಲ"]],"transliteration":[["O panduranga prabho vittala venugopala rukmini lola ||O panduranga||venugopala rukmini lola | |"],["Ninnee paavana padagala | mahimeya bannise matugala | kaanenu tande vittalaa || O panduranga ||"],["Aakasha bhumigala aledanta paada |kaalingana shiradi kunidadida paada | kaananadi kallaada munisatige jeevava tanda pavana sri padava nambihenayya ||O panduranga||"],["Sri devi poojisuva srihariya paada | bhakutarige mukutiyanu koduvanta paada | paapavanu kalevanta suragange janmisidanta rangana Sripadava nambihenayya |O panduranga ||"],["Prabho vittala prabho vittala"],["You can listen to the song here : https://youtu.be/1E76ZyUTfck"]],"aligned":false,"video":null,"videos":[],"sourceUrl":"https://bhakthilahari.com/2020/06/29/%e0%b2%93-%e0%b2%aa%e0%b2%be%e0%b2%82%e0%b2%a1%e0%b3%81%e0%b2%b0%e0%b2%82%e0%b2%97-%e0%b2%aa%e0%b3%8d%e0%b2%b0%e0%b2%ad%e0%b3%8b-o-panduranga-prabho/"},{"slug":"pandarapuradolu-panduranga","titleKn":"ಪಂಡರಾಪುರದೊಳು ಪಾಂಡುರಂಗ","titleEn":"Pandarapuradolu panduranga","form":"pada","composer":"kanaka-dasa","ankita":"ಕಾಗಿನೆಲೆ ಆದಿಕೇಶವ","raga":null,"tala":null,"stanzas":[["ಪಂಡರಾಪುರದೊಳು ಪಾಂಡುರಂಗ","ಉಡುಪಿಯ ಕೃಷ್ಣ ಪಾಂಡುರಂಗ ||","ಅಯ್ಯೋಧ್ಯೆಯ ರಾಮ ಪಾಂಡುರಂಗ","ಅಹೋಭಲ ನರಸಿಂಹ ಪಾಂಡುರಂಗ || ಪಂಡರಾಪುರದೊಳು||"],["ಗುರುವಾಯೂರು ಕೃಷ್ಣ ಪಾಂಡುರಂಗ","ದ್ವಾರಕನಾಥ ಪಾಂಡುರಂಗ ||","ವೆಂಕಟರಮಣ ಪಾಂಡುರಂಗ","ಶ್ರೀರಂಗನಾಥ ಪಾಂಡುರಂಗ||","||ಪಂಡರಾಪುರದೊಳು||"],["ಬದರಿನಾಥ ಪಾಂಡುರಂಗ","ಭದ್ರಾಚಲ ರಾಮ ಪಾಂಡುರಂಗ ||","ಮಥುರಾನಾಥ ಪಾಂಡುರಂಗ","ಶ್ರೀಕೋಟಿ ಚೆಲುವ ಪಾಂಡುರಂಗ","||ಪಂಡರಾಪುರದೊಳು||"],["ಕಾಶಿ ಬಿಂದು ಮಾಧವ ಪಾಂಡುರಂಗ","ಕಾಗಿನೆಲೆ ಕೇಶವ ಪಾಂಡುರಂಗ||","ಜಗನ್ನಾಥ ಪುರಿಯಲಿ ಪಾಂಡುರಂಗ","ಜಯರಾಮ ವಿಠ್ಠಲ ಪಾಂಡುರಂಗ","||ಪಂಡರಾಪುರದೊಳು||"]],"transliteration":[["Pandarapuradolu panduranga | udupiya krishna panduranga || ayodhyeya rama panduranga | ahobala narasimha panduranga || pandarapuradolu ||"],["Guruvayur krishna panduranga | dwarakanatha panduranga || venkataramana panduranga | sriranganatha panduranga || pandarapuradolu ||"],["Badarinatha panduranga | bhadrachala rama panduranga || mathuranatha panduranga | srikoti cheluva panduranga ||pandarapuradolu ||"],["Kashi bindu madhava panduranga | kaginele keshava panduranga || jagannaatha puriyali panduranga | jayarama vittala panduranga || pandarapuradolu ||"]],"aligned":true,"video":"Lpru0s9dD5s","videos":["Lpru0s9dD5s"],"sourceUrl":"https://bhakthilahari.com/2022/11/13/%e0%b2%aa%e0%b2%82%e0%b2%a1%e0%b2%b0%e0%b2%be%e0%b2%aa%e0%b3%81%e0%b2%b0%e0%b2%a6%e0%b3%8a%e0%b2%b3%e0%b3%81-%e0%b2%aa%e0%b2%be%e0%b2%82%e0%b2%a1%e0%b3%81%e0%b2%b0%e0%b2%82%e0%b2%97-pandarapuradolu/"},{"slug":"pandharapuravemba-dodda-nagara","titleKn":"ಪಂಡರಾಪುರವೆಂಬ ದೊಡ್ಡ ನಗರ","titleEn":"Pandharapuravemba dodda nagara","form":"pada","composer":"purandara-dasa","ankita":"ಪುರಂದರ ವಿಠಲ","raga":null,"tala":null,"stanzas":[["ಪಂಢರಾಪುರವೆಂಬ ದೊಡ್ಡ ನಗರ ಅಲ್ಲಿ ವಿಠೋಬನೆಂಬ ಸಾಹುಕಾರ","ವಿಠೋಬನಿರುವದು ನದಿ ತೀರ ಅಲ್ಲಿ ಪಂಢರಿ ಭಜನೆ ವ್ಯಾಪಾರ ||ಪ.||"],["ತಂದೆ ನೀನೆ ತಾಯಿ ನೀನೆ ಪಾಂಡುರಂಗ ನಮ್ಮ ಬಂಧು ನೀನೆ ಬಳಗ ನೀನೆ ಪಾಂಡುರಂಗ","ಭಕ್ತರ ಪೋಷಕ ಪಾಂಡುರಂಗ ನಮ್ಮ ಮುಕ್ತಿದಾಯಕ ಪಾಂಡುರಂಗ ||೧||"],["ವಿಠೋಬನಿಗೆ ಪ್ರಿಯ ತುಳಸಿಹಾರ ಅಲ್ಲಿ ಭಕ್ತ ಜನರ ವ್ಯಾಪಾರ","ವಿಠೋಬನಿಗೆ ಪ್ರಿಯ ಬುಕ್ಕಿಯ ಗಂಧ ಅಲ್ಲಿ ಚಂದ್ರಭಾಗಾ ಸ್ನಾನ ಬಲು ಅಂದ ||೨||"],["ಶ್ರೀಹರಿ ವಿಠ್ಠಲ ಪಾಂಡುರಂಗ ಜಯ ಹರಿ ವಿಠ್ಠಲ ಪಾಂಡುರಂಗ","ವಿಠ್ಠಲ ವಿಠ್ಠಲ ಪಾಂಡುರಂಗ ನಮ್ಮ ಪುರಂದರ ವಿಠ್ಠಲ ಪಾಂಡುರಂಗ ||೩||"]],"transliteration":[["Pandharapuravemba dodda nagara alli vithobanemba sahukara |","vithobaniruvadu naditeera alli pandharibhajane vyapara ||pa.||"],["Tande neene tayi neene panduranga namma bandhu neene balaga neene panduranga |","bhaktara poshaka panduranga namma muktidayaka panduranga ||1||"],["Vithobanige priya tulasihara alli bhakta janara vyapara |","vithobanige priya bukkiya gandha alli chandrabhaga snana balu anda ||2||"],["Shrihari vitthala panduranga jaya hari vitthala panduranga |","vitthala vitthala panduranga namma purandara vitthala panduranga ||3||"]],"aligned":true,"video":"6nF9q2UvX5o","videos":["6nF9q2UvX5o"],"sourceUrl":"https://bhakthilahari.com/2021/02/10/%e0%b2%aa%e0%b2%82%e0%b2%a1%e0%b2%b0%e0%b2%be%e0%b2%aa%e0%b3%81%e0%b2%b0%e0%b2%b5%e0%b3%86%e0%b2%82%e0%b2%ac-%e0%b2%a6%e0%b3%8a%e0%b2%a1%e0%b3%8d%e0%b2%a1-%e0%b2%a8%e0%b2%97%e0%b2%b0-pandharapuravem/"},{"slug":"vidyanagaradi-vittalana-vittalana","titleKn":"ವಿದ್ಯಾನಗರದಿ ವಿಠ್ಠಲನ ವಿಠ್ಠಲನ","titleEn":"Vidyanagaradi vittalana vittalana","form":"song","composer":null,"ankita":null,"raga":null,"tala":null,"stanzas":[["ವಿದ್ಯಾನಗರದಿ ವಿಠ್ಠಲನ ವಿಠ್ಠಲನ ಸನ್ನಿಧಿಯಲ್ಲಿ ಪ್ರಸಿದ್ಧವಾದ ಭಾಗವತರಾ ಆ ಸಮ್ಮೇಳನದಲ್ಲಿ |","ತೆರಳಿದರೋ ತೆರಳಿದರೋ |","ನಮ್ಮ ಪುರಂದರದಾಸರು ನಿಜವೈಕುಂಠಕೆ ತೆರಳಿದರೋ ||"],["ಆ ಮಹಾತ್ಮರು ಆ ಯೋಗಿವರೇಣ್ಯರು ತೆರಳಿದರೋ","ತೆರಳಿದರೋ ತೆರಳಿದರೋ ||"],["ಮೇರು ದುಂದುಭಿಯು ಮೊಳಗುತಿರೆ","ತೆರಳಿದರೋ ತೆರಳಿದರೋ |","ಆ ಮಹಾತ್ಮರು ಆ ಯೋಗಿವರೇಣ್ಯರು","ತೆರಳಿದರೋ ತೆರಳಿದರೋ ||"],["ರಕ್ತಾಕ್ಷಿ ಸಂವತ್ಸರದ ಉತ್ತರಾಯಣದಲ್ಲಿ |","ಪೌಷ ಬಹುಳ ಅಮವಾಸ್ಯ ಮಂಗಳವಾರ ದಿನದಲ್ಲಿ |","ತೆರಳಿದರೋ ತೆರಳಿದರೋ |"],["ಗುರು ಮಧ್ವಪತಿ ವಿಠ್ಠಲನ ಧರೆಗೆ ತೋರಿಸಿದರೋ |","ಆ ಮಹಾತ್ಮರು ಆ ಯೋಗಿವರೇಣ್ಯರು","ತೆರಳಿದರೋ ತೆರಳಿದರೋ ||","ನಮ್ಮ ಪುರಂದರದಾಸರು ನಿಜವೈಕುಂಠಕೆ","ತೆರಳಿದರೋ ಅ ಮಹಾತ್ಮರು |","ಆ ಯೋಗಿವರೇಣ್ಯರು ತೆರಳಿದರೋ","ತೆರಳಿದರೋ ತೆರಳಿದರೋ… ||"]],"transliteration":[["Vidyanagaradi vittalana vittalana sannidhiyalli |","Prasiddavada bhagavatara a sammelanadalli, teralidaro teralidaro | namma purandaradasaru nija vaikuntake teralidaro a mahatmarutire | a yogivarenyaru teralidaro | teralidaro teralidaro ||"],["Meru dundubhiyu molagutire teralidaro teralidaro |a mahatmaru, yogivarenyaru teralidaro teralidaro ||"],["raktakshi samvatsarada uttarayanadalli | pousha bahula amavasya mangalavara dinadalli | teralidaro teralidaro ||"],["Guru madhwapati vittalana dharege torisidaro | a mahatmaru a yogivarenyaru teralidaro teralidaro || namma purandara dasaru nijavaikuntake teralidaro a mahatmaru | a yogivarenyaru teralidaro teralidaro teralidaro ……. ||"]],"aligned":false,"video":"Tx38q8Lb_Bc","videos":["Tx38q8Lb_Bc","zhAaU7r6GNU"],"sourceUrl":"https://bhakthilahari.com/2022/11/28/%e0%b2%b5%e0%b2%bf%e0%b2%a6%e0%b3%8d%e0%b2%af%e0%b2%be%e0%b2%a8%e0%b2%97%e0%b2%b0%e0%b2%a6%e0%b2%bf-%e0%b2%b5%e0%b2%bf%e0%b2%a0%e0%b3%8d%e0%b2%a0%e0%b2%b2%e0%b2%a8-%e0%b2%b5%e0%b2%bf%e0%b2%a0%e0%b3%8d/"},{"slug":"vittala-panduranga","titleKn":"ವಿಠ್ಠಲ ಪಾಂಡುರಂಗ","titleEn":"vittala panduranga","form":"pada","composer":"sripadaraja","ankita":"ರಂಗವಿಠಲ","raga":null,"tala":null,"stanzas":[["ವಿಠ್ಠಲ ಪಾಂಡುರಂಗ ||"],["ಶಂಖಚಕ್ರಧರ ವೈಜಯಂತಿಧರ","ಪೀತಾಂಬರಧರ ಗೋವರ್ಧನೋದ್ಧರ","ತುಲಸಿ ಮಾಲಾ ಶೋಭಿತ ಗಳಲಾ","ಗರುಡ ಗಮನ ಹರಿ ಪಂಕಜನಾಭಾ","ಹೊ ವಿಠಲಾ ಯೇರೆ ಪಂಢರಿರಾಯ ವಿಠಲಾ ಯೇರೆ ಪಂಢರಿರಾಯ","ವಿಠಲ ಪಾಂಡುರಂಗ ವಿಠಲ ಪಾಂಡುರಂಗ","ವಿಠಲ ಪಾಂಡುರಂಗ ವಿಠಲ ಪಾಂಡುರಂಗ"],["ಮಸ್ತಕ ಲಿಂಗ ಸ್ವರೂಪ ಲಿಂಗ","ರೂಪ ಬಂಗ ಸಜ್ಜನ ಸಂಗ","ಯದುಕುಲ ತಿಲಕ ಮನ್ಮಥ ಜನಕ","ಪತಿತ ಪಾವನ ದೀನ ದಯಾಳಾ","ಹೊ ವಿಠಲಾ ಯೇರೆ ಪಂಢರಿರಾಯ ವಿಠಲಾ ಯೇರೆ ಪಂಢರಿರಾಯ","ವಿಠ್ಠಲ ವಿಠ್ಠಲ ಜೈಜೈ ವಿಠ್ಠಲ ||2||","ವಿಠ್ಠಲ ವಿಠ್ಠಲ ಶ್ರೀಹರಿ ವಿಠ್ಠಲ ||2||"],["ತ್ರಿಭುವನ ರೂಪ ವಿಶ್ವಸ್ವರೂಪ","ಭವಭಯ ತಾಪ ಹರತಿ ಪಾಪ","ರುಕ್ಮಿಣಿ ಕಾಂತ ರೂಪ ಅನಂತಾ","ಜನನಿ ಜನಕ ತುಝ ಮಾವಕಲೇನ","ಹೊ ವಿಠಲಾ ಯೇರೆ ಪಂಢರಿರಾಯ ವಿಠಲಾ ಯೇರೆ ಪಂಢರಿರಾಯ","ವಿಠಲ ಪಾಂಡುರಂಗ ವಿಠಲ ಪಾಂಡುರಂಗ","ವಿಠಲ ಪಾಂಡುರಂಗ ವಿಠಲ ಪಾಂಡುರಂಗ"],["ಚಂದ್ರಭಾಗೆ ತೀರಿ ಉಭಾವಿಠೇವರಿ","ಕರಕಟಾವರಿ ರಂಗ ಶಿಲೆವರಿ","ಜಗದೋದ್ಧಾರಾ ವೇದೋದ್ಧಾರ","ಭಕ್ತಸಾಗರ ಪಂಢರಪುರಾ","ಹೊ ವಿಠಲಾ ಯೇರೆ ಪಂಢರಿರಾಯ ವಿಠಲಾ ಯೇರೆ ಪಂಢರಿರಾಯ","ವಿಠಲ ಪಾಂಡುರಂಗ ವಿಠಲ ಪಾಂಡುರಂಗ","ವಿಠಲ ಪಾಂಡುರಂಗ ವಿಠಲ ಪಾಂಡುರಂಗ"]],"transliteration":[["Vittala panduranga ||"],["Shankhachakradhara vaijayanti dhara","pitambharadhara govardhanoddhara","tulasimale shobhitagala","garudagamana hari pankajanabha","ho vittalayere pandariraya vittala yere pandariraya ||vittala||"],["Mastakalinga swaroopa linga","roopabhanga sajjana Sangha","yadukula tilaka manmatajanaka","patitapavana deenadayalu","vittalayere pandariraya vittala yere pandariraya ||vittala||","vittala vittala jaijai vittala","vittala vittala srihari vittala"],["Tribhuvana roopa vishwa swaroopa","bhavabhaya tapa harisi papa","rukmini kanta roopa ananta","janani janaka tuja màvakalena","vittalayere pandariraya vittala yere pandariraya ||","Vittala vittala jai jai vittala","vittala vittala sri hari vittala"],["Chandrabhage teeri ubhavitevari","karakataavari ranga shilevari","jagadodhaara vedoddhara","bhaktasagara pandarapura","ho vittala yere pandariraya vittala yere pandariraya||","vittala panduranga vittala panduranga","vittala panduranga vittala panduranga"],["https://youtu.be/8djSxyebyWE"]],"aligned":false,"video":null,"videos":[],"sourceUrl":"https://bhakthilahari.com/2023/01/10/%e0%b2%b5%e0%b2%bf%e0%b2%a0%e0%b3%8d%e0%b2%a0%e0%b2%b2-%e0%b2%aa%e0%b2%be%e0%b2%82%e0%b2%a1%e0%b3%81%e0%b2%b0%e0%b2%82%e0%b2%97-vittala-panduranga/"}]