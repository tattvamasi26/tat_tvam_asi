{
 "chandrashekhara-ashtakam": [
  {
   "n": "1",
   "lines": [
    "चन्द्रशेखर चन्द्रशेखर चन्द्रशेखर पाहि माम् ।",
    "चन्द्रशेखर चन्द्रशेखर चन्द्रशेखर रक्ष माम् ॥"
   ]
  },
  {
   "n": "2",
   "lines": [
    "रत्नसानुशरासनं रजताद्रिशृङ्गनिकेतनं",
    "सिञ्जिनीकृतपन्नगेश्वरमच्युताननसायकम् ।",
    "क्षिप्रदग्धपुरत्रयं त्रिदिवालयैरभिवन्दितं",
    "चन्द्रशेखरमाश्रये मम किं करिष्यति वै यमः ॥"
   ]
  },
  {
   "n": "3",
   "lines": [
    "पञ्चपादपपुष्पगन्धपदाम्बुजद्वयशोभितं",
    "भाललोचनजातपावकदग्धमन्मथविग्रहम् ।",
    "भस्मदिग्धकलेबरं भवनाशनं भवमव्ययं",
    "चन्द्रशेखरमाश्रये मम किं करिष्यति वै यमः ॥"
   ]
  },
  {
   "n": "4",
   "lines": [
    "मत्तवारणमुख्यचर्मकृतोत्तरीयमनोहरं",
    "पङ्कजासनपद्मलोचनपूजिताङ्घ्रिसरोरुहम् ।",
    "देवसिन्धुतरङ्गशीकरसिक्तशुभ्रजटाधरं",
    "चन्द्रशेखरमाश्रये मम किं करिष्यति वै यमः ॥"
   ]
  },
  {
   "n": "5",
   "lines": [
    "यक्षराजसखं भगाक्षहरं भुजङ्गविभूषणं",
    "शैलराजसुतापरिष्कृतचारुवामकलेबरम् ।",
    "क्ष्वेडनीलगलं परश्वथधारिणं मृगधारिणं",
    "चन्द्रशेखरमाश्रये मम किं करिष्यति वै यमः ॥"
   ]
  },
  {
   "n": "6",
   "lines": [
    "कुण्डलीकृतकुण्डलेश्वरकुण्डलं वृषवाहनं",
    "नारदादिमुनीश्वरस्तुतवैभवं भुवनेश्वरम् ।",
    "अन्धकान्धकमाश्रितामरपादपं शमनान्तकं",
    "चन्द्रशेखरमाश्रये मम किं करिष्यति वै यमः ॥"
   ]
  },
  {
   "n": "7",
   "lines": [
    "भेषजं भवरोगिणामखिलापदामपहारिणं",
    "दक्षयज्ञविनाशनं त्रिगुणात्मकं त्रिविलोचनम् ।",
    "भक्तिमुक्तिफलप्रदं सकलाघसङ्घनिबर्हणं",
    "चन्द्रशेखरमाश्रये मम किं करिष्यति वै यमः ॥"
   ]
  },
  {
   "n": "8",
   "lines": [
    "भक्तवत्सलमर्चितं निधिमक्षयं हरिदम्बरं",
    "सर्वभूतपतिं परात्परमप्रमेयमनुत्तमम् ।",
    "सोमवारिनभोहुताशनसोमपानिलखाकृतिं",
    "चन्द्रशेखरमाश्रये मम किं करिष्यति वै यमः ॥"
   ]
  },
  {
   "n": "9",
   "lines": [
    "विश्वसृष्टिविधायिनं पुनरेव पालनतत्परं",
    "संहरन्तमपि प्रपञ्चमशेषलोकनिवासिनम् ।",
    "क्रीडयन्तमहर्निशं गणनाथयूथसमन्वितं",
    "चन्द्रशेखरमाश्रये मम किं करिष्यति वै यमः ॥"
   ]
  },
  {
   "n": "10",
   "lines": [
    "मृत्युभीतमृकण्डसूनुकृतस्तवं शिवसन्निधौ",
    "यत्रकुत्र च यः पठेन्नहि तस्य मृत्युभयं भवेत् ।",
    "पूर्णमायुररोगितामखिलार्थसम्पदमादरं",
    "चन्द्रशेखर एव तस्य ददाति मुक्तिमयत्नतः ॥"
   ]
  }
 ],
 "shiva-panchakshara-stotram": [
  {
   "n": "1",
   "lines": [
    "नागेन्द्रहाराय विलोचनाय",
    "भस्माङ्गरागाय महेश्वराय ।",
    "नित्याय शुद्धाय दिगम्बराय",
    "तस्मै नकाराय नमः शिवाय ॥"
   ]
  },
  {
   "n": "2",
   "lines": [
    "मन्दाकिनीसलिलचन्दनचर्चिताय",
    "नन्दीश्वरप्रमथनाथमहेश्वराय ।",
    "मन्दारमुख्यबहुपुष्पसुपूजिताय",
    "तस्मै मकाराय नमः शिवाय ॥"
   ]
  },
  {
   "n": "3",
   "lines": [
    "शिवाय गौरीवदनाब्जबृन्द-",
    "सूर्याय दक्षाध्वरनाशकाय ।",
    "श्रीनीलकण्ठाय वृषध्वजाय",
    "तस्मै शिकाराय नमः शिवाय ॥"
   ]
  },
  {
   "n": "4",
   "lines": [
    "वसिष्ठकुम्भोद्भवगौतमार्य-",
    "मुनीन्द्रदेवार्चितशेखराय।",
    "चन्द्रार्कवैश्वानरलोचनाय",
    "तस्मै वकाराय नमः शिवाय ॥"
   ]
  },
  {
   "n": "5",
   "lines": [
    "यक्षस्वरूपाय जटाधराय",
    "पिनाकहस्ताय सनातनाय ।",
    "दिव्याय देवाय दिगम्बराय",
    "तस्मै यकाराय नमः शिवाय ॥"
   ]
  },
  {
   "n": "6",
   "lines": [
    "पञ्चाक्षरमिदं पुण्यं यः पठेच्छिवसन्निधौ ।",
    "शिवलोकमवाप्नोति शिवेन सह मोदते ॥"
   ]
  }
 ],
 "shiva-tandava-stotram": [
  {
   "n": "1",
   "lines": [
    "जटाकटाहसम्भ्रमभ्रमन्निलिम्पनिर्झरी-",
    "विलोलवीचिवल्लरीविराजमानमूर्धनि ।",
    "धगद्धगद्धगज्ज्वलल्ललाटपट्टपावके",
    "किशोरचन्द्रशेखरे रतिः प्रतिक्षणं मम ॥"
   ]
  },
  {
   "n": "2",
   "lines": [
    "धराधरेन्द्रनन्दिनीविलासबन्धुबन्धुर-",
    "स्फुरद्दिगन्तसन्ततिप्रमोदमानमानसे ।",
    "कृपाकटाक्षधोरणीनिरुद्धदुर्धरापदि",
    "क्वचिच्चिदम्बरे मनो विनोदमेतु वस्तुनि ॥"
   ]
  },
  {
   "n": "3",
   "lines": [
    "जटाभुजङ्गपिङ्गलस्फुरत्फणामणिप्रभा-",
    "कदम्बकुङ्कुमद्रवप्रलिप्तदिग्वधूमुखे ।",
    "मदान्धसिन्धुरस्फुरत्त्वगुत्तरीयमेदुरे",
    "मनो विनोदमद्भुतं बिभर्तु भूतभर्तरि ॥"
   ]
  },
  {
   "n": "4",
   "lines": [
    "सहस्रलोचनप्रभृत्यशेषलेखशेखर-",
    "प्रसूनधूलिधोरणीविधूसराङ्घ्रिपीठभूः ।",
    "भुजङ्गराजमालया निबद्धजाटजूटकः",
    "श्रियै चिराय जायतां चकोरबन्धुशेखरः ॥"
   ]
  },
  {
   "n": "5",
   "lines": [
    "ललाटचत्वरज्वलद्धनञ्जयस्फुलिङ्गभा-",
    "निपीतपञ्चसायकं नमन्निलिम्पनायकम् ।",
    "सुधामयूखलेखया विराजमानशेखरं",
    "महाकपालिसम्पदे शिरो जटालमस्तु नः॥"
   ]
  },
  {
   "n": "6",
   "lines": [
    "करालभालपट्टिकाधगद्धगद्धगज्ज्वल-",
    "द्धनञ्जयाधरीकृतप्रचण्डपञ्चसायके ।",
    "धराधरेन्द्रनन्दिनीकुचाग्रचित्रपत्रक-",
    "प्रकल्पनैकशिल्पिनि त्रिलोचने मतिर्मम ॥"
   ]
  },
  {
   "n": "7",
   "lines": [
    "नवीनमेघमण्डलीनिरुद्धदुर्धरस्फुर-",
    "त्कुहूनिशीथिनीतमःप्रबन्धबन्धुकन्धरः।",
    "निलिम्पनिर्झरीधरस्तनोतु कृत्तिसिन्धुरः",
    "कलानिधानबन्धुरः श्रियं जगद्धुरन्धरः ॥"
   ]
  },
  {
   "n": "8",
   "lines": [
    "प्रफुल्लनीलपङ्कजप्रपञ्चकालिमच्छटा-",
    "विडम्बिकण्ठकन्धरारुचिप्रबन्ध कन्धरम् ।",
    "स्मरच्छिदं पुरच्छिदं भवच्छिदं मखच्छिदं",
    "गजच्छिदान्धकच्छिदं तमन्तकच्छिदं भजे ॥"
   ]
  },
  {
   "n": "9",
   "lines": [
    "अगर्वसर्वमङ्गलाकलाकदम्बमञ्जरी-",
    "रसप्रवाहमाधुरीविजृम्भणामधुव्रतम् ।",
    "स्मरान्तकं पुरान्तकं भवान्तकं मखान्तकं",
    "गजान्तकान्धकान्तकं तमन्तकान्तकं भजे ॥"
   ]
  },
  {
   "n": "10",
   "lines": [
    "जयत्वदभ्रविभ्रमभ्रमद्भुजङ्गमस्फुर-",
    "द्धगद्धगद्विनिर्गमत्करालफालहव्यवाट् ।",
    "धिमिद्धिमिद्धिमिध्वनन्मृदङ्गतुङ्गमङ्गल-",
    "ध्वनिक्रमप्रवर्तितप्रचण्डताण्डवः शिवः ॥"
   ]
  },
  {
   "n": "11",
   "lines": [
    "दृषद्विचित्रतल्पयोर्भुजङ्गमौक्तिकस्रजो-",
    "र्गरिष्ठरत्नलोष्ठयोः सुहृद्विपक्षपक्षयोः।",
    "तृणारविन्दचक्षुषोः प्रजामहीमहेन्द्रयोः",
    "समं प्रवर्तयन्मनः कदा सदाशिवं भजे ॥"
   ]
  },
  {
   "n": "12",
   "lines": [
    "कदा निलिम्पनिर्झरीनिकुञ्जकोटरे वस-",
    "न्विमुक्तदुर्मतिः सदा शिरःस्थमञ्जलिं वहन् ।",
    "विमुक्तलोललोचनाललामफाललग्नकः",
    "शिवेति मन्त्रमुच्चरन्कदा सुखी भवाम्यहम् ॥"
   ]
  },
  {
   "n": "13",
   "lines": [
    "इमं हि नित्यमेवमुक्तमुत्तमोत्तमं स्तवं",
    "पठन्स्मरन्ब्रुवन्नरो विशुद्धिमेति सन्ततम् ।",
    "हरे गुरौ स भक्तिमाशु याति नान्यथा गतिं",
    "विमोहनं हि देहिनां तु शङ्करस्य चिन्तनम् ॥"
   ]
  },
  {
   "n": "14",
   "lines": [
    "पूजावसानसमये दशवक्त्रगीतं",
    "यः शम्भुपूजनमिदं पठति प्रदोषे ।",
    "तस्य स्थिरां रथगजेन्द्रतुरङ्गयुक्तां",
    "लक्ष्मीं सदैव सुमुखीं प्रददाति शम्भुः ॥"
   ]
  }
 ],
 "dvadasha-jyotirlinga-stotram": [
  {
   "n": "1",
   "lines": [
    "सौराष्ट्रदेशे विदशेऽतिरम्ये",
    "ज्योतिर्मयं चन्द्रकलावतंसम् ।",
    "भक्तिप्रदानाय कृपावतीर्णं",
    "तं सोमनाथं शरणं प्रपद्ये ॥"
   ]
  },
  {
   "n": "2",
   "lines": [
    "श्रीशैलसङ्गे विबुधातिसङ्गे",
    "तुलाद्रितुङ्गेऽपि मुदा वसन्तम् ।",
    "तमर्जुनं मल्लिकपूर्वमेकं",
    "नमामि संसारसमुद्रसेतुम् ॥"
   ]
  },
  {
   "n": "3",
   "lines": [
    "अवन्तिकायां विहितावतारं",
    "मुक्तिप्रदानाय च सज्जनानाम् ।",
    "अकालमृत्योः परिरक्षणार्थं",
    "वन्दे महाकालमहासुरेशम् ॥"
   ]
  },
  {
   "n": "4",
   "lines": [
    "कावेरिकानर्मदयोः पवित्रे",
    "समागमे सज्जनतारणाय ।",
    "सदैव मान्धातृपुरे वसन्त -",
    "मोङ्कारमीशं शिवमेकमीडे॥"
   ]
  },
  {
   "n": "5",
   "lines": [
    "पूर्वोत्तरे प्रज्वलिकानिधाने",
    "सदा वसन्तं गिरिजासमेतम् ।",
    "सुरासुराराधितपादपद्मं",
    "श्रीवैद्यनाथं तमहं नमामि ॥"
   ]
  },
  {
   "n": "6",
   "lines": [
    "याम्ये सदङ्गे नगरेऽतिरम्ये",
    "विभूषिताङ्गं विविधैश्च भोगैः।",
    "सद्भक्तिमुक्तिप्रदमीशमेकं",
    "श्रीनागनाथं शरणं प्रपद्ये ॥"
   ]
  },
  {
   "n": "7",
   "lines": [
    "महाद्रिपार्श्वे च तटे रमन्तं",
    "सम्पूज्यमानं सततं मुनीन्द्रैः ।",
    "सुरासुरैर्यक्षमहोरगाद्यैः",
    "केदारमीशं शिवमेकमीडे॥"
   ]
  },
  {
   "n": "8",
   "lines": [
    "सह्याद्रिशीर्षे विमले वसन्तं",
    "गोदावरीतीरपवित्रदेशे।",
    "यद्दर्शनात्पातकमाशु नाशं",
    "प्रयाति तं त्र्यम्बकमीशमीडे॥"
   ]
  },
  {
   "n": "9",
   "lines": [
    "सुताम्रपर्णीजलराशियोगे",
    "निबध्य सेतुं विशिखैरसंख्यैः।",
    "श्रीरामचन्द्रेण समर्पितं तं",
    "रामेश्वराख्यं नियतं नमामि ॥"
   ]
  },
  {
   "n": "10",
   "lines": [
    "यो डाकिनीशाकिनिकासमाजै-",
    "र्निषेव्यमाणः पिशिताशनैश्च ।",
    "सदैव भीमादिपदप्रसिद्धः",
    "तं शङ्करं भक्तहितं नमामि ॥"
   ]
  },
  {
   "n": "11",
   "lines": [
    "सानन्दमानन्दवने वसन्त-",
    "मानन्दकन्दं हतपापबृन्दम् ।",
    "वाराणसीनाथमनाथनाथं",
    "श्रीविश्वनाथं शरणं प्रपद्ये ॥"
   ]
  },
  {
   "n": "12",
   "lines": [
    "इलापुरे रम्यविशालकेऽस्मि-",
    "न्समुल्लसन्तं च जगद्वरेण्यम्।",
    "नित्यं महोदारतरस्वभावं",
    "घृष्णेश्वराख्यं शरणं प्रपद्ये ॥"
   ]
  },
  {
   "n": "13",
   "lines": [
    "ज्योतिर्मयद्वादशलिङ्गकानां",
    "शिवात्मनां प्रोक्तमिदं क्रमेण ।",
    "स्तोत्रं पठित्वा मनुजाऽतिभक्त्या",
    "फलं तदालोक्यनिशं भजेच्च ॥"
   ]
  }
 ],
 "vedasara-shiva-stava": [
  {
   "n": "1",
   "lines": [
    "पशूनां पतिं पापनाशं परेशं",
    "गजेंद्रस्य कृत्तिं वसानं वरेण्यम् ।",
    "जटाजूटमध्ये स्फुरद्गाङ्गवारिं",
    "महादेवमेकं स्मरामि स्मरारिम् ॥"
   ]
  },
  {
   "n": "2",
   "lines": [
    "महेशं सुरेशं सुरारातिनाशं",
    "विभुं विश्वनाथं विभूत्यङ्गभूषम् ।",
    "विरूपाक्षमिन्द्वर्कवह्नित्रिनेत्रं",
    "सदानन्दमीडे प्रभुं पञ्चवक्त्रम् ॥"
   ]
  },
  {
   "n": "3",
   "lines": [
    "गिरीशं गणेशं गले नीलवर्णं",
    "गवेन्द्रादिरूढं गणातीतरूपम् ।",
    "भवं भास्वरं भस्मना भूषिताङ्गं",
    "भवानीकलत्रं भजे पञ्चवक्त्रम् ॥"
   ]
  },
  {
   "n": "4",
   "lines": [
    "शिवाकान्त शम्भो शशाङ्कार्धमौले",
    "महेशान शूलिन् जटाजूटधारिन् ।",
    "त्वमेको जगद्व्यापको विश्वरूप",
    "प्रसीद प्रसीद प्रभो पूर्णरूप ॥"
   ]
  },
  {
   "n": "5",
   "lines": [
    "परात्मानमेकं जगद्बीजमाद्यं",
    "निरीहं निराकारमोङ्कारवेद्यम् ।",
    "यतो जायते पाल्यते येन विश्वं",
    "तमीशं भजे लीयते यत्र विश्वम् ॥"
   ]
  },
  {
   "n": "6",
   "lines": [
    "न भूमिर्न चापो न वह्निर्न वायु-",
    "र्न चाकाशमास्ते न तन्द्रा न निद्रा।",
    "न ग्रीष्मो न शीतं न देशो न वेषो",
    "न यस्यास्ति मूर्तिस्त्रिमूर्तिं तमीडे ॥"
   ]
  },
  {
   "n": "7",
   "lines": [
    "अजं शाश्वतं कारणं कारणानां",
    "शिवं केवलं भासकं भासकानाम् ।",
    "तुरीयं तमःपारमाद्यन्तहीनं",
    "प्रपद्ये परं पावनं द्वैतहीनम् ॥"
   ]
  },
  {
   "n": "8",
   "lines": [
    "नमस्ते नमस्ते विभो विश्वमूर्ते",
    "नमस्ते नमस्ते चिदानन्दमूर्ते।",
    "नमस्ते नमस्ते तपोयोगगम्य",
    "नमस्ते नमस्ते श्रुतिज्ञानगम्य ॥"
   ]
  },
  {
   "n": "9",
   "lines": [
    "प्रभो शूलपाणे विभो विश्वनाथ",
    "महादेव शंभो महेश त्रिनेत्र ।",
    "शिवाकान्त शान्त स्मरारे पुरारे",
    "त्वदन्यो वरेण्यो न मान्यो न गण्यः ॥"
   ]
  },
  {
   "n": "10",
   "lines": [
    "शम्भो महेश करुणामय शूलपाणे",
    "गौरीपते पशुपते पशुपाशनाशिन् ।",
    "काशीपते करुणया जगदेतदेक-",
    "स्त्वं हंसि पासि विदधासि महेश्वरोऽसि ॥"
   ]
  },
  {
   "n": "11",
   "lines": [
    "त्वत्तो जगद्भवति देव भव स्मरारे",
    "त्वय्येव तिष्ठति जगन्मृड विश्वनाथ ।",
    "त्वय्येव गच्छति लयं जगदेतदीश",
    "लिङ्गात्मकं हर चराचरविश्वरूपिन् ॥"
   ]
  }
 ],
 "nirvana-dashakam": [
  {
   "n": "1",
   "lines": [
    "न भूमिर्न तोयं न तेजो न वायु-",
    "र्न खं नेंद्रियं वा न तेषां समूहः ।",
    "अनैकान्तिकत्वात्सुषुप्त्येकसिद्ध-",
    "स्तदेकोऽवशिष्टः शिवः केवलोऽहम् ॥"
   ]
  },
  {
   "n": "2",
   "lines": [
    "न वर्णा न वर्णाश्रमाचारधर्मा",
    "न मे धारणाध्यानयोगादयोऽपि ।",
    "अनात्माश्रयोऽहं ममाध्यासहानात्तदेकोऽवशिष्टः शिवः केवलोऽहम् ॥"
   ]
  },
  {
   "n": "3",
   "lines": [
    "न माता पिता वा न देवा न लोका",
    "न देवा न यज्ञा न तीर्थं ब्रुवन्ति ।",
    "सुषुप्तौ निरस्तातिशून्यात्मकत्वात्तदेकोऽवशिष्टः शिवः केवलोऽहम् ॥"
   ]
  },
  {
   "n": "4",
   "lines": [
    "न सांख्यं न शैवं न तत्पाञ्चरात्रं",
    "न जैनं न मीमांसकादेर्मतं वा ।",
    "विशिष्टानुभूत्या विशुद्धात्मकत्वात्तदेकोऽवशिष्टः शिवः केवलोऽहम् ॥"
   ]
  },
  {
   "n": "5",
   "lines": [
    "न शुक्लं न कृष्णं न रक्तं न पीतं",
    "न पीनं न कुब्जं न ह्रस्वं दीर्घम् ।",
    "अरूपं तथा ज्योतिराकारकत्वात्तदेकोऽवशिष्टः शिवः केवलोऽहम् ॥"
   ]
  },
  {
   "n": "6",
   "lines": [
    "न जाग्रन्न मे स्वप्नको वा सुषुप्ति-",
    "र्न विश्वो न वा तेजसःप्राज्ञको वा।",
    "अविद्यात्मकत्वात्त्रयाणां तुरीयं तदेकोऽवशिष्टः शिवः केवलोऽहम् ॥"
   ]
  },
  {
   "n": "7",
   "lines": [
    "न शास्ता न शास्त्रं न शिष्यो न शिक्षा",
    "न च त्वं न चाहं न चायं प्रपञ्चः।",
    "स्वरूपावबोधाद्विकल्पासहिष्णुस्तदेकोऽवशिष्टः शिवः केवलोऽहम् ॥"
   ]
  },
  {
   "n": "8",
   "lines": [
    "न चोर्ध्वं न चाधो न चान्तर्न बाह्यं",
    "न मध्यं न तिर्यङ् न पूर्वा परा दिक् ।",
    "वियद्व्यापकत्वादखण्डैकरूपस्तदेकोऽवशिष्टः शिवः केवलोऽहम् ॥"
   ]
  },
  {
   "n": "9",
   "lines": [
    "अपि व्यापकत्वादितत्त्वात्प्रयोगा-",
    "त्स्वतःसिद्धभावादनन्याश्रयत्वात् ।",
    "जगत्तुच्छमेतत्समस्तं तदन्यस्तदेकोऽवशिष्टः शिवः केवलोऽहम् ॥"
   ]
  },
  {
   "n": "10",
   "lines": [
    "न चैकं तदन्यद्द्वितीयं कुतः स्या-",
    "न्न चाकेवलत्वं न वा केवलत्वम् ।",
    "न शून्यं न चाशून्यमद्वैतकत्वा-",
    "त्कथं सर्ववेदान्तसिद्धं ब्रवीमि ॥"
   ]
  }
 ],
 "nirvana-shatkam": [
  {
   "n": "1",
   "lines": [
    "मनोबुद्ध्यहङ्कारचित्तानि नाहं",
    "न च श्रोत्रजिह्वे न च घ्राणनेत्रे ।",
    "न च व्योम भूमिर्न तेजो न वायु-",
    "श्चिदानन्दरूपः शिवोऽहं शिवोऽहम् ॥"
   ]
  },
  {
   "n": "2",
   "lines": [
    "न च प्राणसंज्ञो न वै पञ्चवायु-",
    "र्न वा सप्तधातुर्न वा पञ्चकोशः।",
    "न वाक्पाणिपादं न चोपस्थपायू चिदानन्दरूपः शिवोऽहं शिवोऽहम् ॥"
   ]
  },
  {
   "n": "3",
   "lines": [
    "न मे द्वेषरागौ न मे लोभमोहौ",
    "मदो नैव मे नैव मात्सर्यभावः ।",
    "न धर्मो न चार्थो न कामो न मोक्षश्चिदानन्दरूपः शिवोऽहं शिवोऽहम् ॥"
   ]
  },
  {
   "n": "4",
   "lines": [
    "न पुण्यं न पापं न सौख्यं न दुःखं",
    "न मंत्रो न तीर्थं न वेदा न यज्ञाः ।",
    "अहं भोजनं नैव भोज्यं न भोक्ता चिदानन्दरूपः शिवोऽहं शिवोऽहम् ॥"
   ]
  },
  {
   "n": "5",
   "lines": [
    "न मृत्युर्न शङ्का न मे जातिभेदः",
    "पिता नैव मे नैव माता च जन्म ।",
    "न बन्धुर्न मित्रं गुरुर्नैव शिष्यश्चिदानन्दरूपः शिवोऽहं शिवोऽहम् ॥"
   ]
  },
  {
   "n": "6",
   "lines": [
    "अहं निर्विकल्पो निराकाररूपो",
    "विभुत्वाच्च सर्वत्र सर्वेन्द्रियाणाम् ।",
    "न चासङ्गतं नैव मुक्तिर्न मेयश्चिदानन्दरूपः शिवोऽहं शिवोऽहम् ॥"
   ]
  }
 ],
 "ardhanarishvara-stotram": [
  {
   "n": "1",
   "lines": [
    "चाम्पेयगौरार्धशरीरकायै",
    "कर्पूरगौरार्धशरीरकाय ।",
    "धम्मिल्लकायैच जटाधराय",
    "नमः शिवायै च नमः शिवाय ॥"
   ]
  },
  {
   "n": "2",
   "lines": [
    "कस्तूरिकाकुङ्कुमचर्चितायै",
    "चितारजःपुञ्जविचर्चिताय ।",
    "कृतस्मरायै विकृतस्मराय नमः शिवायै च नमः शिवाय ॥"
   ]
  },
  {
   "n": "3",
   "lines": [
    "झणत्क्वणत्कङ्कणनूपुरायै",
    "पादाब्जराजत्फणिनूपुराय ।",
    "हेमाङ्गदायै भुजगाङ्गदाय नमः शिवायै च नमः शिवाय ॥"
   ]
  },
  {
   "n": "4",
   "lines": [
    "विशालनीलोत्पललोचनायै",
    "विकासिपङ्केरुहलोचनाय ।",
    "समेक्षणायै विषमेक्षणाय नमः शिवायै च नमः शिवाय ॥"
   ]
  },
  {
   "n": "5",
   "lines": [
    "मन्दारमालाकलितालकायै",
    "कपालमालाङ्कितकन्धराय ।",
    "दिव्याम्बरायै च दिगम्बराय नमः शिवायै च नमः शिवाय ॥"
   ]
  },
  {
   "n": "6",
   "lines": [
    "अम्भोधरश्यामलकुन्तलायै",
    "तटित्प्रभाताम्रजटाधराय ।",
    "निरीश्वरायै निखिलेश्वराय नमः शिवायै च नमः शिवाय ॥"
   ]
  },
  {
   "n": "7",
   "lines": [
    "प्रपञ्चसृष्ट्युन्मुखलास्यकायै",
    "समस्तसंहारकताण्डवाय ।",
    "जगज्जनन्यै जगदेकपित्रे नमः शिवायै च नमः शिवाय ॥"
   ]
  },
  {
   "n": "8",
   "lines": [
    "प्रदीप्तरत्नोज्ज्वलकुण्डलायै",
    "स्फुरन्महापन्नगभूषणाय ।",
    "शिवान्वितायै च शिवान्विताय नमः शिवायै च नमः शिवाय ॥"
   ]
  },
  {
   "n": "9",
   "lines": [
    "एतत्पठेदष्टकमिष्टदं यो",
    "भक्त्या स मान्यो भुवि दीर्घजीवी।",
    "प्राप्नोति सौभाग्यमनन्तकालं",
    "भूयात्सदा तस्य समस्तसिद्धिः ॥"
   ]
  }
 ],
 "shiva-namavali-ashtakam": [
  {
   "n": "1",
   "lines": [
    "हे चन्द्रचूड मदनान्तक शूलपाणे",
    "स्थाणो गिरीश गिरिजेश महेशशम्भो।",
    "भूतेशभीतभयसूदनमामनाथं",
    "संसारदुःखगहनाज्जगदीश रक्ष ॥"
   ]
  },
  {
   "n": "2",
   "lines": [
    "हे पार्वतीहृदयवल्लभ चन्द्रमौले",
    "भूताधिप प्रमथनाथ गिरीश चाप ।",
    "हे वामदेव भव रुद्र पिनाकपाणे संसारदुःखगहनाज्जगदीश रक्ष ॥"
   ]
  },
  {
   "n": "3",
   "lines": [
    "हे नीलकण्ठ वृषभध्वज पञ्चवक्त्र",
    "लोकेश शेषवलय प्रमथेश शर्व।",
    "हे धूर्जटे पशुपते गिरिजापते मां संसारदुःखगहनाज्जगदीश रक्ष ॥"
   ]
  },
  {
   "n": "4",
   "lines": [
    "हे विश्वनाथ शिवशङ्कर देवदेव",
    "गङ्गाधर प्रमथनायक नन्दिकेश ।",
    "बाणेश्वरान्धकरिपो हर लोकनाथ संसारदुःखगहनाज्जगदीश रक्ष ॥"
   ]
  },
  {
   "n": "5",
   "lines": [
    "वाराणसीपुरपते मणिकर्णिकेश",
    "वीरेश दक्षमखकाल विभो गणेश।",
    "सर्वज्ञ सर्वहृदयैकनिवास संसारदुःखगहनाज्जगदीश रक्ष ॥"
   ]
  },
  {
   "n": "6",
   "lines": [
    "श्रीमन्महेश्वर कृपामय हे दयालो",
    "हे व्योमकेश शितिकण्ठ गणाधिनाथ ।",
    "भस्माङ्गराग नृकपालकलापमाल संसारदुःखगहनाज्जगदीश रक्ष ॥"
   ]
  },
  {
   "n": "7",
   "lines": [
    "कैलासशैलविनिवास वृषाकपे हे",
    "मृत्युञ्जय त्रिनयन त्रिजगन्निवास।",
    "नारायणप्रियमदापह शक्तिनाथ संसारदुःखगहनाज्जगदीश रक्ष ॥"
   ]
  },
  {
   "n": "8",
   "lines": [
    "विश्वेश विश्वभवनाशक विश्वरूप",
    "विश्वात्मक त्रिभुवनैकगुणाधिकेश ।",
    "हे विश्वनाथ करुणामय दीनबन्धो संसारदुःखगहनाज्जगदीश रक्ष ॥"
   ]
  },
  {
   "n": "9",
   "lines": [
    "गौरीविलासभवनाय महेश्वराय",
    "पञ्चाननाय शरणागतकल्पकाय ।",
    "शर्वाय सर्वजगतामधिपाय तस्मै",
    "दारिद्र्यदुःखदहनाय नमः शिवाय ॥"
   ]
  }
 ],
 "daridrya-dahana-shiva-stotram": [
  {
   "n": "1",
   "lines": [
    "विश्वेश्वराय नरकार्णवतारणाय",
    "कर्णामृताय शशिशेखरधारणाय ।",
    "कर्पूरकान्तिधवलाय जटाधराय",
    "दारिद्र्यदुःखदहनाय नमः शिवाय ॥"
   ]
  },
  {
   "n": "2",
   "lines": [
    "गौरीप्रियाय रजनीशकलाधराय",
    "कालान्तकाय भुजगाधिपकङ्कणाय ।",
    "गङ्गाधराय गजराजविमर्दनाय दारिद्र्यदुःखदहनाय नमः शिवाय ॥"
   ]
  },
  {
   "n": "3",
   "lines": [
    "भक्तिप्रियाय भवरोगभयापहाय",
    "उग्राय दुर्गभवसागरतारणाय ।",
    "ज्योतिर्मयाय गुणनामसुनृत्यकाय दारिद्र्यदुःखदहनाय नमः शिवाय ॥"
   ]
  },
  {
   "n": "4",
   "lines": [
    "चर्माम्बराय शवभस्मविलेपनाय",
    "भालेक्षणाय मणिकुण्डलमण्डिताय ।",
    "मञ्जीरपादयुगलाय जटाधराय दारिद्र्यदुःखदहनाय नमः शिवाय ॥"
   ]
  },
  {
   "n": "5",
   "lines": [
    "पञ्चाननाय फणिराजविभूषणाय",
    "हेमांशुकाय भुवनत्रयमण्डिताय ।",
    "आनन्दभूमिवरदाय तमोमयाय दारिद्र्यदुःखदहनाय नमः शिवाय ॥"
   ]
  },
  {
   "n": "6",
   "lines": [
    "भानुप्रियाय भवसागरतारणाय",
    "कालान्तकाय कमलासनपूजिताय ।",
    "नेत्रत्रयाय शुभलक्षणलक्षिताय दारिद्र्यदुःखदहनाय नमः शिवाय ॥"
   ]
  },
  {
   "n": "7",
   "lines": [
    "रामप्रियाय रघुनाथवरप्रदाय",
    "नागप्रियाय नरकार्णवतारणाय ।",
    "पुण्येषु पुण्यभरिताय सुरार्चिताय दारिद्र्यदुःखदहनाय नमः शिवाय ॥"
   ]
  },
  {
   "n": "8",
   "lines": [
    "मुक्तेश्वराय फलदाय गणेश्वराय",
    "गीतप्रियाय वृषभेश्वरवाहनाय ।",
    "मातङ्गचर्मवसनाय महेश्वराय दारिद्र्यदुःखदहनाय नमः शिवाय ॥"
   ]
  },
  {
   "n": "9",
   "lines": [
    "वसिष्ठेन कृतं स्तोत्रं सर्वरोगनिवारणम् ।",
    "सर्वसंपत्करं शीघ्रं पुत्रपौत्राभिवर्धनम् ।",
    "त्रिसन्ध्यं यः पठेन्नित्यं स हि स्वर्गमवाप्नुयात् ॥"
   ]
  }
 ],
 "shankara-ashtakam": [
  {
   "n": "1",
   "lines": [
    "शीर्षजटागणभारं गरलाहारं समस्तसंहारम् ।",
    "कैलासाद्रिविहारं पारं भववारिधेरहं वन्दे ॥"
   ]
  },
  {
   "n": "2",
   "lines": [
    "चन्द्रकलोज्ज्वलफालं कण्ठव्यालं जगत्त्रयीफालम् ।",
    "कृतनरमस्तकमालं कालं कालस्य कोमलं वन्दे ॥"
   ]
  },
  {
   "n": "3",
   "lines": [
    "कोपेक्षणहतकामं स्वात्मारामं नगेन्द्रजावामम् ।",
    "संसृतिशोकविरामं श्यामं कण्ठेन कारणं वन्दे ॥"
   ]
  },
  {
   "n": "4",
   "lines": [
    "कटितटविलसितनागं खण्डितयागं महाद्भुतत्यागम् ।",
    "विगतविषयरसरागं भागं यज्ञेषु बिभ्रतं वन्दे ॥"
   ]
  },
  {
   "n": "5",
   "lines": [
    "त्रिपुरादिकदनुजांतं गिरिजाकान्तं सदैव संशान्तम्",
    "लीलाविजितकृतान्तं भान्तं स्वान्तेषु देहिनां वन्दे ॥"
   ]
  },
  {
   "n": "6",
   "lines": [
    "सुरसरिदाप्लुतकेशं त्रिदशकुलेशं हृदालयावेशम् ।",
    "विगताशेषक्लेशं देशं सर्वेष्टसम्पदां वन्दे ॥"
   ]
  },
  {
   "n": "7",
   "lines": [
    "करतलकलितपिनाकं विगतजराकं सुकर्मणां पाकम् ।",
    "परपदवीतवराकं नाकङ्गमपूगवन्दितं वन्दे ॥"
   ]
  },
  {
   "n": "8",
   "lines": [
    "भूतिविभूषितकायं दुस्तरमायं विवर्जितापायम् ।",
    "प्रमथसमूहसहायं सायं प्रातर्निरन्तरं वन्दे ॥"
   ]
  },
  {
   "n": "9",
   "lines": [
    "यस्तु पदाष्टकमेतद्ब्रह्मानन्देन निर्मितं नित्यम् ।",
    "पठति समाहितचेताः प्राप्नोत्यन्ते स शैवमेव पदम् ॥"
   ]
  }
 ],
 "yati-panchakam": [
  {
   "n": "1",
   "lines": [
    "वेदान्तवाक्येषु सदा रमन्तः भिक्षान्नमात्रेणच",
    "तुष्टिमन्तः । विशोकमन्तःकरणे रमन्तः कौपीन-",
    "वन्तः खलु भाग्यवन्तः ॥"
   ]
  },
  {
   "n": "2",
   "lines": [
