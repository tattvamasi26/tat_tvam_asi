# Copy this file to .env.setup (git-ignored), fill it in, then run:
#   npm run setup:auth
# Running it again is safe: it updates what is there.

# ── Required ────────────────────────────────────────────────
# supabase.com → your avatar (bottom left) → Account preferences →
# Access Tokens → Generate new token. Copy it here.
SUPABASE_ACCESS_TOKEN=

# ── Optional: names and addresses ──────────────────────────
SUPABASE_PROJECT_NAME=tat-tvam-asi
# ap-south-1 is Mumbai.
SUPABASE_REGION=ap-south-1
# Where readers are sent back after signing in. Use the live address
# (https://tattvam-asi.org) once the site is deployed.
SITE_URL=http://localhost:3000
# Other addresses allowed to receive a sign-in, comma-separated.
EXTRA_SITE_URLS=http://localhost:3000,http://localhost:3001

# ── Google sign-in (leave empty for the first run) ─────────
# The first run prints the redirect address Google needs. Then create the
# OAuth client in Google Cloud Console and paste its two values here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email codes (optional) ─────────────────────────────────
# Supabase's own mailer only reaches your Supabase team, so the public
# needs an SMTP service. Resend's free tier works:
#   SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_USER=resend
#   SMTP_PASS=<your Resend API key>
#   SMTP_SENDER_EMAIL=signin@<a domain you verified in Resend>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=Tat Tvam Asi
